import GptLean.PhysicalSmearedKernel
import PfHk.CutoffKernel

/-!
The Fourier representation of the photon source generated by an integrable
classical current. The Fourier coefficient convention is the unnormalized
one already used in `gpt_lean`. The harmless nonzero normalization does not
affect the cutoff kernel.
-/

noncomputable section

namespace PfHk

open MeasureTheory Filter GptLean GptLean.PhysicalFock GptLean.PhysicalPairSpace
  GptLean.PhysicalGroundState GptLean.PhysicalPolarization GptLean.Gaussian
open scoped ENNReal InnerProductSpace

set_option Elab.async false
set_option backward.isDefEq.respectTransparency.types false
set_option maxHeartbeats 600000

variable (F : Frame) (χ : ArticleCutoff)

def sourceComponent (a : Fin 3) (b : Position → ℝ) (p : PhotonMode) : ℂ :=
  base F χ a p * fourierCoeff b p.1

theorem sourceComponent_memLp (a : Fin 3) {b : Position → ℝ}
    (hb : Integrable b volume) : MemLp (sourceComponent F χ a b) 2 photonMeasure := by
  apply ((base_memLp F χ a).norm.const_mul (∫ x, ‖b x‖)).mono'
    (((base_measurable F χ a).mul
      ((continuous_fourierCoeff b hb).measurable.comp measurable_fst)).aestronglyMeasurable)
  filter_upwards with p
  change ‖base F χ a p * fourierCoeff b p.1‖ ≤ _
  rw [norm_mul, mul_comm]
  exact mul_le_mul_of_nonneg_right (norm_fourierCoeff_le b p.1) (norm_nonneg _)

def sourceComponentL2 (a : Fin 3) (b : Position → ℝ) (hb : Integrable b volume) :
    Lp ℂ 2 photonMeasure := (sourceComponent_memLp F χ a hb).toLp _

/-- Joint integrability for the Fubini interchange in the source formula. -/
theorem source_integrand_integrable (a : Fin 3) {b : Position → ℝ}
    (hb : Integrable b volume) (z : Lp ℂ 2 photonMeasure) :
    Integrable (fun q : PhotonMode × Position =>
      starRingEnd ℂ (z q.1) * (fieldPhase q.1.1 q.2 * base F χ a q.1) * (b q.2 : ℂ))
      (photonMeasure.prod volume) := by
  have hnorm : Integrable (fun p => ‖z p‖ * ‖base F χ a p‖) photonMeasure :=
    memLp_one_iff_integrable.mp ((base_memLp F χ a).norm.mul' (Lp.memLp z).norm)
  have hphase : Measurable (fun q : PhotonMode × Position => fieldPhase q.1.1 q.2) := by
    unfold fieldPhase
    fun_prop
  apply (hnorm.mul_prod hb.norm).mono'
    ((((Complex.continuous_conj.comp_aestronglyMeasurable
      (Lp.aestronglyMeasurable z).comp_fst).mul
      (hphase.aestronglyMeasurable.mul
        ((base_measurable F χ a).comp measurable_fst).aestronglyMeasurable)).mul
          (Complex.continuous_ofReal.comp_aestronglyMeasurable hb.1.comp_snd)))
  filter_upwards with q
  simp [norm_fieldPhase, Complex.norm_real]

/-- Pairing the Fourier source with an arbitrary photon vector gives the
spatial integral of the field-kernel pairing. -/
theorem inner_sourceComponent (a : Fin 3) {b : Position → ℝ}
    (hb : Integrable b volume) (z : Lp ℂ 2 photonMeasure) :
    ⟪z, sourceComponentL2 F χ a b hb⟫_ℂ =
      ∫ x, (b x : ℂ) * ⟪z, kernelAt F χ a x⟫_ℂ := by
  have hi := source_integrand_integrable F χ a hb z
  have hleft : ⟪z, sourceComponentL2 F χ a b hb⟫_ℂ =
      ∫ p, ∫ x, starRingEnd ℂ (z p) *
        (fieldPhase p.1 x * base F χ a p) * (b x : ℂ) ∂volume ∂photonMeasure := by
    rw [L2.inner_def]
    apply integral_congr_ae
    filter_upwards [(sourceComponent_memLp F χ a hb).coeFn_toLp] with p hp
    change ⟪z p, sourceComponentL2 F χ a b hb p⟫_ℂ = _
    rw [show sourceComponentL2 F χ a b hb p = sourceComponent F χ a b p from hp]
    simp only [RCLike.inner_apply, sourceComponent, PhysicalGroundState.fourierCoeff]
    rw [← integral_const_mul, ← integral_mul_const]
    apply integral_congr_ae
    filter_upwards with x
    ring
  rw [hleft, integral_integral_swap hi]
  apply integral_congr_ae
  filter_upwards with x
  rw [L2.inner_def, ← integral_const_mul]
  apply integral_congr_ae
  filter_upwards [kernelAt_ae F χ a x] with p hp
  rw [hp]
  simp only [RCLike.inner_apply]
  ring

def fourierSource (b : Position → Vector) (p : PhotonMode) : ℂ :=
  ∑ a : Fin 3, sourceComponent F χ a (fun x => b x a) p

theorem fourierSource_memLp {b : Position → Vector} (hb : Integrable b volume) :
    MemLp (fourierSource F χ b) 2 photonMeasure := by
  apply memLp_finsetSum
  intro a _
  exact sourceComponent_memLp F χ a
    ((EuclideanSpace.proj a : Vector →L[ℝ] ℝ).integrable_comp hb)

def fourierSourceL2 (b : Position → Vector) (hb : Integrable b volume) :
    Lp ℂ 2 photonMeasure := (fourierSource_memLp F χ hb).toLp _

theorem fourierSourceL2_eq_sum {b : Position → Vector} (hb : Integrable b volume) :
    fourierSourceL2 F χ b hb = ∑ a : Fin 3, sourceComponentL2 F χ a
      (fun x => b x a) ((EuclideanSpace.proj a : Vector →L[ℝ] ℝ).integrable_comp hb) := by
  have hall : ∀ᵐ p ∂photonMeasure, ∀ a : Fin 3,
      sourceComponentL2 F χ a (fun x => b x a)
        ((EuclideanSpace.proj a : Vector →L[ℝ] ℝ).integrable_comp hb) p =
      sourceComponent F χ a (fun x => b x a) p := by
    rw [ae_all_iff]
    intro a
    exact (sourceComponent_memLp F χ a
      ((EuclideanSpace.proj a : Vector →L[ℝ] ℝ).integrable_comp hb)).coeFn_toLp
  apply Lp.ext
  filter_upwards [(fourierSource_memLp F χ hb).coeFn_toLp,
    Lp.coeFn_finsetSum Finset.univ (fun a => sourceComponentL2 F χ a
      (fun x => b x a) ((EuclideanSpace.proj a : Vector →L[ℝ] ℝ).integrable_comp hb)),
    hall] with p hp hsum hall
  rw [show fourierSourceL2 F χ b hb p = fourierSource F χ b p from hp, hsum]
  simp only [fourierSource, Finset.sum_apply, hall]

/-- The actual Bochner source and the explicit Fourier kernel are the
same one-photon vector. -/
theorem currentSource_fst_eq_fourierSource {b : Position → Vector}
    (hb : Integrable b volume) :
    (currentSource F χ b).val.1 = fourierSourceL2 F χ b hb := by
  apply ext_inner_left ℂ
  intro z
  let P : PhysicalFock.WeightedPhotonKernel →L[ℝ] ℂ :=
    ((innerSL ℂ z).restrictScalars ℝ).comp
      (PhysicalNonattainmentFluxKernel.component false)
  have hmap : P (currentSource F χ b) =
      ∑ a : Fin 3, ∫ x, P ((b x a) • PhysicalWeyl.fieldKernel F χ (a, x)) := by
    rw [currentSource, map_sum]
    apply Finset.sum_congr rfl
    intro a _
    exact (P.integral_comp_comm (currentSource_integrable F χ hb a)).symm
  change P (currentSource F χ b) = _
  rw [hmap, fourierSourceL2_eq_sum F χ hb, inner_sum]
  apply Finset.sum_congr rfl
  intro a _
  rw [inner_sourceComponent]
  apply integral_congr_ae
  filter_upwards with x
  rw [map_smul]
  rfl

theorem fourierSource_ae_zero_of_currentSource_zero {b : Position → Vector}
    (hb : Integrable b volume) (hzero : currentSource F χ b = 0) :
    fourierSource F χ b =ᵐ[photonMeasure] 0 := by
  have hz : fourierSourceL2 F χ b hb = 0 := by
    rw [← currentSource_fst_eq_fourierSource F χ hb, hzero]
    rfl
  exact (fourierSource_memLp F χ hb).coeFn_toLp.symm.trans
    (Lp.eq_zero_iff_ae_eq_zero.mp hz)

end PfHk
