import GptLean.PhotonLocalizationKernelCutoffs
import Mathlib.Analysis.Calculus.ContDiff.RCLike

/-!
The cutoff commutator estimate for the photon radiation form.

The analytic background below consists of the three-dimensional radial
integration formulas for inverse powers and the volume growth of balls.
It is uniform in the centre and radius and does not mention a photon
cutoff. The estimates for the actual smooth retained cutoff are proved
from these formulas.
-/

namespace GptLean.PhotonLocalizationFormBounds

open MeasureTheory Set
open scoped NNReal
open PhotonLocalizationKernelCutoffs

variable {P : Type*} [NormedAddCommGroup P] [InnerProductSpace ℝ P]

theorem retained_hasCompactSupport [FiniteDimensional ℝ P] :
    HasCompactSupport (retained (P := P) 1) := by
  apply HasCompactSupport.of_support_subset_isCompact
    (isCompact_closedBall (0 : P) 2)
  intro y hy
  by_contra hn
  have hh : 2 ≤ ‖y‖ := by
    have hn' : 2 < dist y 0 := not_le.mp hn
    simpa only [dist_zero_right] using hn'.le
  have he : retained 1 y = 0 := retained_eq_zero (by norm_num) (by simpa using hh)
  exact hy he

/-- Smoothness of the single fixed bump produces the common Lipschitz
constant for every rescaling. -/
theorem retained_exists_lipschitz [FiniteDimensional ℝ P] :
    ∃ L : ℝ≥0, ∀ R : ℝ, 0 < R → ∀ y z : P,
      |retained R y - retained R z| ≤ (L : ℝ) / R * ‖y - z‖ := by
  obtain ⟨L, hL⟩ := (retained_smooth (P := P) 1).lipschitzWith_of_hasCompactSupport
    retained_hasCompactSupport (by simp)
  refine ⟨L, fun R hR y z => ?_⟩
  have h := hL.dist_le_mul (R⁻¹ • y) (R⁻¹ • z)
  simpa only [retained, inv_one, one_smul, Real.dist_eq, dist_eq_norm,
    ← smul_sub, norm_smul, Real.norm_eq_abs, abs_inv, abs_of_pos hR, div_eq_mul_inv,
    mul_assoc] using h

/-- The elementary radial kernels used in dimension three. Values at
the origin are set to zero by real division. -/
noncomputable def nearKernel (R : ℝ) (z y : P) : ℝ :=
  if ‖y - z‖ ≤ R then 1 / ‖y - z‖ ^ 2 else 0

noncomputable def farKernel (R : ℝ) (z y : P) : ℝ :=
  if R < ‖y - z‖ then 1 / ‖y - z‖ ^ 4 else 0

noncomputable def ballWeight (R : ℝ) (y : P) : ℝ := if ‖y‖ ≤ R then 1 else 0

section Integration

variable [MeasurableSpace P] [BorelSpace P] {μ : Measure P}

/-- Standard radial integration facts in three dimensions. The constants
are harmless upper bounds for the surface area and ball volume factors.
No multiplication operator or localized form appears in this background. -/
structure RadialIntegration (μ : Measure P) where
  area : ℝ
  area_nonneg : 0 ≤ area
  volume : ℝ
  volume_nonneg : 0 ≤ volume
  near_integrable : ∀ R : ℝ, 0 < R → ∀ z, Integrable (nearKernel R z) μ
  far_integrable : ∀ R : ℝ, 0 < R → ∀ z, Integrable (farKernel R z) μ
  near_integral : ∀ R : ℝ, 0 < R → ∀ z,
    (∫ y, nearKernel R z y ∂μ) ≤ area * R
  far_integral : ∀ R : ℝ, 0 < R → ∀ z,
    (∫ y, farKernel R z y ∂μ) ≤ area / R
  ball_integrable : ∀ R : ℝ, 0 < R → Integrable (ballWeight R) μ
  ball_integral : ∀ R : ℝ, 0 < R →
    (∫ y, ballWeight R y ∂μ) ≤ volume * R ^ 3

/-- The actual scalar kernel generated by the retained photon cutoff. -/
noncomputable def cutoffKernel (R : ℝ) (z y : P) : ℝ :=
  (retained R y - retained R z) ^ 2 / ‖y - z‖ ^ 4

omit [MeasurableSpace P] [BorelSpace P] in
theorem cutoffKernel_nonneg (R : ℝ) (z y : P) : 0 ≤ cutoffKernel R z y :=
  div_nonneg (sq_nonneg _) (by positivity)

theorem cutoffKernel_measurable (R : ℝ) (z : P) :
    AEStronglyMeasurable (cutoffKernel R z) μ := by
  exact (((retained_smooth R).continuous.measurable.sub measurable_const).pow_const 2 |>.div
    (((continuous_id.sub continuous_const).norm.measurable).pow_const 4)).aestronglyMeasurable

omit [MeasurableSpace P] [BorelSpace P] in
theorem cutoffKernel_near_far {R L : ℝ} (hR : 0 < R) (hL : 0 ≤ L)
    (hLip : ∀ y z : P, |retained R y - retained R z| ≤ L / R * ‖y - z‖)
    (z y : P) :
    cutoffKernel R z y ≤ (L / R) ^ 2 * nearKernel R z y + farKernel R z y := by
  by_cases hd : ‖y - z‖ = 0
  · simp [cutoffKernel, nearKernel, farKernel, hd]
  have hdpos : 0 < ‖y - z‖ := lt_of_le_of_ne (norm_nonneg _) (Ne.symm hd)
  by_cases hr : ‖y - z‖ ≤ R
  · simp only [nearKernel, hr, ↓reduceIte, farKernel, not_lt.mpr hr, add_zero]
    unfold cutoffKernel
    have hs : (retained R y - retained R z) ^ 2 ≤ (L / R * ‖y - z‖) ^ 2 := by
      simpa only [sq_abs] using (sq_le_sq₀ (abs_nonneg _)
        (mul_nonneg (div_nonneg hL hR.le) (norm_nonneg _))).2 (hLip y z)
    calc
      _ ≤ (L / R * ‖y - z‖) ^ 2 / ‖y - z‖ ^ 4 :=
        div_le_div_of_nonneg_right hs (by positivity)
      _ = _ := by field_simp
  · simp only [nearKernel, hr, ↓reduceIte, farKernel, lt_of_not_ge hr, mul_zero, zero_add]
    unfold cutoffKernel
    apply div_le_div_of_nonneg_right _ (by positivity)
    nlinarith [retained_nonneg R y, retained_nonneg R z,
      retained_le_one R y, retained_le_one R z]

theorem cutoffKernel_integrable (D : RadialIntegration μ) {R L : ℝ}
    (hR : 0 < R) (hL : 0 ≤ L)
    (hLip : ∀ y z : P, |retained R y - retained R z| ≤ L / R * ‖y - z‖)
    (z : P) : Integrable (cutoffKernel R z) μ := by
  apply ((D.near_integrable R hR z).const_mul ((L / R) ^ 2) |>.add
    (D.far_integrable R hR z)).mono' (cutoffKernel_measurable R z)
  exact ae_of_all _ fun y => by
    rw [Real.norm_eq_abs, abs_of_nonneg (cutoffKernel_nonneg R z y)]
    exact cutoffKernel_near_far hR hL hLip z y

/-- The near-field commutator estimate, uniformly in its centre. -/
theorem cutoffKernel_integral_le_radius (D : RadialIntegration μ) {R L : ℝ}
    (hR : 0 < R) (hL : 0 ≤ L)
    (hLip : ∀ y z : P, |retained R y - retained R z| ≤ L / R * ‖y - z‖)
    (z : P) :
    (∫ y, cutoffKernel R z y ∂μ) ≤ D.area * (L ^ 2 + 1) / R := by
  calc
    _ ≤ ∫ y, (L / R) ^ 2 * nearKernel R z y + farKernel R z y ∂μ :=
      integral_mono (cutoffKernel_integrable D hR hL hLip z)
        (((D.near_integrable R hR z).const_mul _).add (D.far_integrable R hR z))
        (cutoffKernel_near_far hR hL hLip z)
    _ = (L / R) ^ 2 * (∫ y, nearKernel R z y ∂μ) + ∫ y, farKernel R z y ∂μ := by
      rw [integral_add ((D.near_integrable R hR z).const_mul _)
        (D.far_integrable R hR z), integral_const_mul]
    _ ≤ (L / R) ^ 2 * (D.area * R) + D.area / R :=
      add_le_add (mul_le_mul_of_nonneg_left (D.near_integral R hR z) (sq_nonneg _))
        (D.far_integral R hR z)
    _ = _ := by field_simp

omit [MeasurableSpace P] [BorelSpace P] in
/-- Far from the cutoff support only its ball volume contributes. -/
theorem cutoffKernel_far {R : ℝ} (hR : 0 < R) {z : P}
    (hz : 4 * R < ‖z‖) (y : P) :
    cutoffKernel R z y ≤ 16 / ‖z‖ ^ 4 * ballWeight (2 * R) y := by
  have hz0 : 0 < ‖z‖ := by linarith
  have hθz : retained R z = 0 := retained_eq_zero hR (by linarith)
  by_cases hy : ‖y‖ ≤ 2 * R
  · have hdist : ‖z‖ / 2 ≤ ‖y - z‖ := by
      have ht := norm_sub_norm_le y z
      rw [norm_sub_rev] at ht
      have ht' := norm_sub_norm_le z y
      rw [norm_sub_rev] at ht'
      linarith
    have hd0 : 0 < ‖y - z‖ := (half_pos hz0).trans_le hdist
    have hd4 : ‖z‖ ^ 4 ≤ 16 * ‖y - z‖ ^ 4 := by
      have hh := pow_le_pow_left₀ (half_pos hz0).le hdist 4
      nlinarith
    simp only [cutoffKernel, hθz, sub_zero, ballWeight, hy, ↓reduceIte, mul_one]
    apply (div_le_div_iff₀ (by positivity : 0 < ‖y - z‖ ^ 4)
      (by positivity : 0 < ‖z‖ ^ 4)).2
    have hθ : retained R y ^ 2 ≤ 1 := pow_le_one₀ (retained_nonneg _ _) (retained_le_one _ _)
    calc
      retained R y ^ 2 * ‖z‖ ^ 4 ≤ ‖z‖ ^ 4 := by nlinarith [pow_nonneg (norm_nonneg z) 4]
      _ ≤ _ := hd4
  · have hθy : retained R y = 0 := retained_eq_zero hR (le_of_not_ge hy)
    simp [cutoffKernel, hθy, hθz, ballWeight, hy]

/-- The two radial regimes combine into the Hardy weight. -/
theorem cutoffKernel_integral_le_hardy (D : RadialIntegration μ) {R L : ℝ}
    (hR : 0 < R) (hL : 0 ≤ L)
    (hLip : ∀ y z : P, |retained R y - retained R z| ≤ L / R * ‖y - z‖)
    {z : P} (hz : 0 < ‖z‖) :
    (∫ y, cutoffKernel R z y ∂μ) ≤
      (4 * D.area * (L ^ 2 + 1) + 2 * D.volume) / ‖z‖ := by
  have hA : 0 ≤ D.area * (L ^ 2 + 1) := mul_nonneg D.area_nonneg (by positivity)
  by_cases hnear : ‖z‖ ≤ 4 * R
  · calc
      _ ≤ D.area * (L ^ 2 + 1) / R := cutoffKernel_integral_le_radius D hR hL hLip z
      _ ≤ (4 * D.area * (L ^ 2 + 1) + 2 * D.volume) / ‖z‖ := by
        apply (div_le_div_iff₀ hR hz).2
        nlinarith [mul_le_mul_of_nonneg_left hnear hA, D.volume_nonneg]
  · have hfar : 4 * R < ‖z‖ := lt_of_not_ge hnear
    calc
      _ ≤ ∫ y, 16 / ‖z‖ ^ 4 * ballWeight (2 * R) y ∂μ :=
        integral_mono (cutoffKernel_integrable D hR hL hLip z)
          ((D.ball_integrable (2 * R) (by positivity)).const_mul _)
          (cutoffKernel_far hR hfar)
      _ = 16 / ‖z‖ ^ 4 * (∫ y, ballWeight (2 * R) y ∂μ) := integral_const_mul _ _
      _ ≤ 16 / ‖z‖ ^ 4 * (D.volume * (2 * R) ^ 3) :=
        mul_le_mul_of_nonneg_left (D.ball_integral (2 * R) (by positivity)) (by positivity)
      _ ≤ (4 * D.area * (L ^ 2 + 1) + 2 * D.volume) / ‖z‖ := by
        have hc : (4 * R) ^ 3 ≤ ‖z‖ ^ 3 := pow_le_pow_left₀ (by positivity) hfar.le 3
        have hv : 128 * D.volume * R ^ 3 ≤ 2 * D.volume * ‖z‖ ^ 3 := by
          nlinarith [mul_le_mul_of_nonneg_left hc D.volume_nonneg]
        calc
          _ = (128 * D.volume * R ^ 3) / ‖z‖ ^ 4 := by ring
          _ ≤ (2 * D.volume * ‖z‖ ^ 3) / ‖z‖ ^ 4 :=
            div_le_div_of_nonneg_right hv (by positivity)
          _ = 2 * D.volume / ‖z‖ := by field_simp
          _ ≤ _ := div_le_div_of_nonneg_right (by nlinarith) hz.le


end Integration

end GptLean.PhotonLocalizationFormBounds
