import GptLean.PhysicalTraceMetric
import Mathlib.Topology.ContinuousMap.Bounded.Normed
import Mathlib.Analysis.Normed.Operator.NNNorm

/-!
Countable bounded observable coordinates for positive normal traces.
Separation is proved on the closed span of rank-one traces using the
spectral representation. No separability of the ambient trace space is
assumed.
-/

noncomputable section
namespace GptLean.PhysicalNormalTrace

open PhotonLocalizationChannel TopologicalSpace Filter Topology
open scoped InnerProductSpace BoundedContinuousFunction

variable {H T : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
  [CompleteSpace H] [NormedAddCommGroup T] [NormedSpace ℝ T]
  {R : Gaussian.RankOneData H T}

/-- The part of the trace space generated by actual rank-one operators. -/
def normalSpan (R : Gaussian.RankOneData H T) : Submodule ℝ T :=
  (Submodule.span ℝ (Set.range R.rankOne)).topologicalClosure

omit [InnerProductSpace ℂ H] [CompleteSpace H] in
theorem rankOne_mem_normalSpan (u : H) : R.rankOne u ∈ normalSpan R :=
  Submodule.le_topologicalClosure _ (Submodule.subset_span ⟨u, rfl⟩)

omit [CompleteSpace H] in
theorem positive_mem_normalSpan [CompleteSpace T] (normal : NormalTraceData R) {x : T}
    (hx : x ∈ R.positive) : x ∈ normalSpan R := by
  obtain ⟨v, hv⟩ := normal.positive_decomposition x hx
  apply (Submodule.isClosed_topologicalClosure _).mem_of_tendsto hv
  exact Eventually.of_forall fun s => (normalSpan R).sum_mem
    (fun n _ => rankOne_mem_normalSpan (v n))

instance normalSpan_separable [SeparableSpace H] : SeparableSpace (normalSpan R) := by
  exact (isSeparable_range R.continuous_rankOne).span.closure.separableSpace

private theorem repr_norm (F : NormalFunctionalData R) (x : T) :
    ‖F.repr x‖ = ‖x‖ := by
  simpa only [map_zero, dist_zero_right] using F.isometry.dist_eq x 0

/-- Uniformly bounded actual operator tests give a bounded coordinate map. -/
def observableCoordinates (F : NormalFunctionalData R)
    (A : ℕ → H →L[ℂ] H) (hA : ∀ n, ‖A n‖ ≤ 1) : T →L[ℝ] (ℕ →ᵇ ℂ) :=
  LinearMap.mkContinuous
    { toFun := fun x => BoundedContinuousFunction.ofNormedAddCommGroup
        (fun n => F.repr x (A n)) (continuous_of_discreteTopology) ‖x‖
        (fun n => by
          calc
            ‖F.repr x (A n)‖ ≤ ‖F.repr x‖ := (F.repr x).unit_le_opNorm _ (hA n)
            _ = ‖x‖ := repr_norm F x)
      map_add' := by intro x y; ext n; simp
      map_smul' := by intro c x; ext n; simp }
    1 (fun x => by
      rw [one_mul]
      exact (BoundedContinuousFunction.norm_le (norm_nonneg x)).mpr fun n =>
        ((F.repr x).unit_le_opNorm _ (hA n)).trans_eq (repr_norm F x))

@[simp] theorem observableCoordinates_apply (F : NormalFunctionalData R)
    (A : ℕ → H →L[ℂ] H) (hA : ∀ n, ‖A n‖ ≤ 1) (x : T) (n : ℕ) :
    observableCoordinates F A hA x n = F.repr x (A n) := rfl

@[simp] theorem observableCoordinates_rankOne (F : NormalFunctionalData R)
    (A : ℕ → H →L[ℂ] H) (hA : ∀ n, ‖A n‖ ≤ 1) (v : H) (n : ℕ) :
    observableCoordinates F A hA (R.rankOne v) n = inner ℂ v (A n v) :=
  F.rankOne v (A n)

variable [SeparableSpace H]

omit [SeparableSpace H] in
private theorem exists_norming_operator (F : NormalFunctionalData R) (x : T) :
    ∃ A : H →L[ℂ] H, ‖A‖ ≤ 1 ∧ ‖x‖ / 2 ≤ ‖F.repr x A‖ := by
  by_cases hx : x = 0
  · exact ⟨0, by simp, by simp [hx]⟩
  · have hp : 0 < ‖x‖ := norm_pos_iff.mpr hx
    obtain ⟨A, hA, h⟩ := (F.repr x).exists_lt_apply_of_lt_opNorm
      (show ‖x‖ / 2 < ‖F.repr x‖ by rw [repr_norm]; linarith)
    exact ⟨A, hA.le, h.le⟩

/-- A countable family chosen from the ordinary bounded operators. -/
def normalOperators (F : NormalFunctionalData R) (n : ℕ) : H →L[ℂ] H :=
  Classical.choose (exists_norming_operator F (denseSeq (normalSpan R) n))

theorem normalOperators_bound (F : NormalFunctionalData R) (n : ℕ) :
    ‖normalOperators F n‖ ≤ 1 :=
  (Classical.choose_spec (exists_norming_operator F (denseSeq (normalSpan R) n))).1

private theorem normalOperators_norming (F : NormalFunctionalData R) (n : ℕ) :
    ‖(denseSeq (normalSpan R) n : T)‖ / 2 ≤
      ‖F.repr (denseSeq (normalSpan R) n) (normalOperators F n)‖ :=
  (Classical.choose_spec (exists_norming_operator F (denseSeq (normalSpan R) n))).2

theorem normalOperators_separate_zero (F : NormalFunctionalData R)
    {x : T} (hx : x ∈ normalSpan R)
    (hzero : ∀ n, F.repr x (normalOperators F n) = 0) : x = 0 := by
  by_contra hne
  have hp : 0 < ‖x‖ := norm_pos_iff.mpr hne
  obtain ⟨n, hn⟩ := (denseRange_denseSeq (normalSpan R)).exists_dist_lt
    (⟨x, hx⟩ : normalSpan R) (by positivity : 0 < ‖x‖ / 8)
  let y : T := denseSeq (normalSpan R) n
  have hdist : ‖y - x‖ < ‖x‖ / 8 := by
    change dist x y < ‖x‖ / 8 at hn
    simpa only [dist_eq_norm, norm_sub_rev] using hn
  have hlower : ‖x‖ ≤ ‖y‖ + ‖y - x‖ := by
    calc
      ‖x‖ = ‖y - (y - x)‖ := by congr 1; abel
      _ ≤ ‖y‖ + ‖y - x‖ := norm_sub_le _ _
  have he : F.repr y (normalOperators F n) =
      F.repr (y - x) (normalOperators F n) := by
    simp only [map_sub, sub_apply, hzero n, sub_zero]
  have hupper : ‖F.repr y (normalOperators F n)‖ ≤ ‖y - x‖ := by
    rw [he]
    exact ((F.repr (y - x)).unit_le_opNorm _ (normalOperators_bound F n)).trans_eq
      (repr_norm F _)
  have hnorm := normalOperators_norming F n
  change ‖y‖ / 2 ≤ _ at hnorm
  linarith

/-- Coordinate equality determines the actual trace for positive normal inputs. -/
theorem normalCoordinates_positive_injective [CompleteSpace T] (normal : NormalTraceData R)
    (F : NormalFunctionalData R) {x y : T} (hx : x ∈ R.positive) (hy : y ∈ R.positive)
    (h : observableCoordinates F (normalOperators F) (normalOperators_bound F) x =
      observableCoordinates F (normalOperators F) (normalOperators_bound F) y) : x = y := by
  apply sub_eq_zero.mp
  apply normalOperators_separate_zero F
    ((normalSpan R).sub_mem (positive_mem_normalSpan normal hx)
      (positive_mem_normalSpan normal hy))
  intro n
  have he := congrArg (fun f : ℕ →ᵇ ℂ => f n) h
  simpa only [observableCoordinates_apply, map_sub, sub_apply,
    sub_eq_zero] using he

/-- Extend an actual positive-state value to the countable coordinate space. -/
def positiveCoordinateValue {α : Type*} [Zero α] (F : NormalFunctionalData R)
    (f : T → α) (z : ℕ →ᵇ ℂ) : α := by
  classical
  exact if h : ∃ x : T, x ∈ R.positive ∧
      observableCoordinates F (normalOperators F) (normalOperators_bound F) x = z
    then f (Classical.choose h) else 0

/-- On positive inputs the coordinate value is exactly the original value.
This applies to extended photon-number forms without a finiteness premise. -/
theorem positiveCoordinateValue_apply {α : Type*} [Zero α] [CompleteSpace T]
    (normal : NormalTraceData R) (F : NormalFunctionalData R) (f : T → α)
    {x : T} (hx : x ∈ R.positive) :
    positiveCoordinateValue F f
      (observableCoordinates F (normalOperators F) (normalOperators_bound F) x) = f x := by
  classical
  have h : ∃ y : T, y ∈ R.positive ∧
      observableCoordinates F (normalOperators F) (normalOperators_bound F) y =
        observableCoordinates F (normalOperators F) (normalOperators_bound F) x := ⟨x, hx, rfl⟩
  rw [positiveCoordinateValue, dite_eq_left h]
  exact congrArg f (normalCoordinates_positive_injective normal F
    (Classical.choose_spec h).1 hx (Classical.choose_spec h).2)

end GptLean.PhysicalNormalTrace
