import GptLean.PhysicalFockHardField
import GptLean.PhysicalFockMixedCCR
import GptLean.PhysicalFockTailPermutation
import GptLean.PhysicalInvariantProjection
import GptLean.PhotonLocalizationLocalFormsOperators
import GptLean.PhysicalFockRadiationGraph
import GptLean.PhysicalFockMomentumProjection

/-!
One soft photon added to a hard Fock vector, for the tagging step of
`thm-many-electron-soft-purification`.

Let `V` be a one-photon subspace (the hard modes) and `f ∈ Vᗮ` (a soft mode).
For a vector `u` of the Fock space generated by `V`, the tagged vector
`a†(f) u` has coordinates `(a†(f) u)₀ = 0` and `(a†(f) u)ₙ₊₁ = a†ₙ(f) uₙ`.
Since `a(f) u = 0`, the sector CCR give

* `‖a†(f) u‖ = ‖f‖ ‖u‖`, so the coordinates are square summable;
* `⟪a†(f) u, a†(g) v⟫ = ⟪f, g⟫ ⟪u, v⟫` for soft `f, g` and hard `u, v`;
* `⟪a†(f) u, w⟫ = 0` for every hard `w`;
* `aₙ(g) a†ₙ(f) uₙ = ⟪g, f⟫ uₙ` for soft `g`, and `a(h) a†(f) = a†(f) a(h)` for hard `h`.

These are the tag identities of the article's proof, with exactly one soft photon.
-/

noncomputable section

namespace GptLean.PhysicalFock.SoftTag

open MeasureTheory Filter
open scoped ENNReal InnerProductSpace

set_option Elab.async false
set_option backward.isDefEq.respectTransparency.types true
set_option maxHeartbeats 800000

variable (C : CanonicalSectorCCR photonMeasure) (V : Submodule ℂ (Lp ℂ 2 photonMeasure))

section Sector

variable {f g : Lp ℂ 2 photonMeasure} {u v : PhotonFock}

include C in
/-- Soft annihilation of a hard vector vanishes in every sector. -/
theorem annihilation_hard (hf : f ∈ Vᗮ) (hu : u ∈ generatedFockSubspace V) (n : ℕ) :
    annihilationSector photonMeasure n f (u (n + 1)) = 0 :=
  annihilationSector_eq_zero_of_orthogonal photonMeasure C V n f hf u hu

include C in
/-- Soft creation on a hard vector is isometric up to `‖f‖`. -/
theorem creation_norm_sq (hf : f ∈ Vᗮ) (hu : u ∈ generatedFockSubspace V) (n : ℕ) :
    ‖creationSector photonMeasure n f (u n)‖ ^ 2 = ‖f‖ ^ 2 * ‖u n‖ ^ 2 := by
  cases n with
  | zero => exact C.vacuum f (u 0)
  | succ n =>
    have h := C.successor f n (u (n + 1))
    rw [annihilation_hard C V hf hu n, norm_zero] at h
    simpa using h

include C in
/-- The tag inner product in one sector. -/
theorem creation_inner (hf : f ∈ Vᗮ) (hv : v ∈ generatedFockSubspace V) (n : ℕ) :
    ⟪creationSector photonMeasure n f (u n), creationSector photonMeasure n g (v n)⟫_ℂ =
      ⟪f, g⟫_ℂ * ⟪u n, v n⟫_ℂ := by
  rw [annihilationSector_duality]
  cases n with
  | zero =>
    rw [sectorCCR_vacuum_apply photonMeasure C f g]
    exact inner_smul_right (𝕜 := ℂ) (u 0) (v 0) ⟪f, g⟫_ℂ
  | succ n =>
    rw [sectorCCR_successor_apply photonMeasure C n f g, annihilation_hard C V hf hv n, map_zero,
      zero_add]
    exact inner_smul_right (𝕜 := ℂ) (u (n + 1)) (v (n + 1)) ⟪f, g⟫_ℂ

include C in
/-- A tag sector is orthogonal to every hard sector. -/
theorem creation_inner_hard (hf : f ∈ Vᗮ) (hv : v ∈ generatedFockSubspace V) (n : ℕ) :
    ⟪creationSector photonMeasure n f (u n), v (n + 1)⟫_ℂ = 0 := by
  rw [annihilationSector_duality, annihilation_hard C V hf hv n, inner_zero_right]

include C in
/-- Soft annihilation removes the tag. -/
theorem annihilation_creation_soft (hg : g ∈ Vᗮ) (hu : u ∈ generatedFockSubspace V) (n : ℕ) :
    annihilationSector photonMeasure n g (creationSector photonMeasure n f (u n)) =
      ⟪g, f⟫_ℂ • u n := by
  cases n with
  | zero => exact sectorCCR_vacuum_apply photonMeasure C g f (u 0)
  | succ n =>
    rw [sectorCCR_successor_apply photonMeasure C n g f, annihilation_hard C V hg hu n, map_zero,
      zero_add]

include C in
/-- Hard annihilation commutes with soft creation. -/
theorem annihilation_creation_hard {h : Lp ℂ 2 photonMeasure} (hh : h ∈ V) (hf : f ∈ Vᗮ)
    (n : ℕ) (x : Sector photonMeasure (n + 1)) :
    annihilationSector photonMeasure (n + 1) h (creationSector photonMeasure (n + 1) f x) =
      creationSector photonMeasure n f (annihilationSector photonMeasure n h x) := by
  rw [sectorCCR_successor_apply photonMeasure C n h f, V.inner_right_of_mem_orthogonal hh hf,
    zero_smul, add_zero]

include C in
theorem annihilation_creation_hard_zero {h : Lp ℂ 2 photonMeasure} (hh : h ∈ V) (hf : f ∈ Vᗮ)
    (x : Sector photonMeasure 0) :
    annihilationSector photonMeasure 0 h (creationSector photonMeasure 0 f x) = 0 := by
  rw [sectorCCR_vacuum_apply photonMeasure C h f, V.inner_right_of_mem_orthogonal hh hf,
    zero_smul]

end Sector

section Shift

variable {K : ℕ → Type*} [∀ n, NormedAddCommGroup (K n)] [∀ n, InnerProductSpace ℂ (K n)]

/-- Inner products of shifted coordinate sequences. -/
theorem shifted_inner (u v c d : lp K 2) (hc : c 0 = 0) (t : ℂ)
    (h : ∀ n, ⟪c (n + 1), d (n + 1)⟫_ℂ = t * ⟪u n, v n⟫_ℂ) :
    ⟪c, d⟫_ℂ = t * ⟪u, v⟫_ℂ := by
  have hs : Summable (fun n : ℕ => ⟪c n, d n⟫_ℂ) := (lp.hasSum_inner (𝕜 := ℂ) c d).summable
  have ht : (∑' n : ℕ, ⟪c n, d n⟫_ℂ) = ⟪c 0, d 0⟫_ℂ + ∑' n : ℕ, ⟪c (n + 1), d (n + 1)⟫_ℂ :=
    hs.tsum_eq_zero_add
  have hz : ⟪c 0, d 0⟫_ℂ = 0 := hc ▸ inner_zero_left _
  calc
    _ = ∑' n : ℕ, ⟪c n, d n⟫_ℂ := lp.inner_eq_tsum c d
    _ = ∑' n : ℕ, ⟪c (n + 1), d (n + 1)⟫_ℂ := by rw [ht, hz, zero_add]
    _ = ∑' n : ℕ, t * ⟪u n, v n⟫_ℂ := tsum_congr h
    _ = t * ∑' n : ℕ, ⟪u n, v n⟫_ℂ := tsum_mul_left
    _ = _ := congrArg (fun z => t * z) (lp.inner_eq_tsum u v).symm

/-- Coordinatewise orthogonal sequences are orthogonal. -/
theorem coordinate_inner_zero (c w : lp K 2) (h : ∀ n, ⟪c n, w n⟫_ℂ = 0) : ⟪c, w⟫_ℂ = 0 :=
  (lp.inner_eq_tsum c w).trans ((tsum_congr h).trans tsum_zero)

end Shift

section Commutation

variable {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) [SigmaFinite μ]

theorem creationSector_val (n : ℕ) (f : Lp ℂ 2 μ) (u : Sector μ n) :
    (creationSector μ n f u).val =
      (Real.sqrt (n + 1 : ℝ) : ℂ) • symmetrizer μ (n + 1) (tensorInsertion μ n f u.val) := rfl

theorem symmetrizer_mem (n : ℕ) (w : FullSector μ n) :
    symmetrizer μ n w ∈ symmetricSubspace μ n :=
  (symmetricSubspace μ n).starProjection_apply_mem w

/-- `⟪z, P w⟫ = ⟪z, w⟫` for symmetric `z`. -/
theorem inner_symmetrizer_right (n : ℕ) (z : FullSector μ n) (hz : z ∈ symmetricSubspace μ n)
    (w : FullSector μ n) : ⟪z, symmetrizer μ n w⟫_ℂ = ⟪z, w⟫_ℂ := by
  have h := (symmetricSubspace μ n).inner_starProjection_left_eq_right z w
  rw [(symmetricSubspace μ n).starProjection_eq_self_iff.mpr hz] at h
  exact h.symm

/-- A symmetric vector orthogonal to every symmetric vector vanishes. -/
theorem eq_zero_of_symmetric (n : ℕ) (d : FullSector μ n) (hd : d ∈ symmetricSubspace μ n)
    (h : ∀ z ∈ symmetricSubspace μ n, ⟪z, d⟫_ℂ = 0) : d = 0 :=
  inner_self_eq_zero.mp (h d hd)

/-- The outer symmetrizer absorbs the inner one: `P(h ⊗ P y) = P(h ⊗ y)`. -/
theorem symmetrizer_insertion_symmetrizer (n : ℕ) (h : Lp ℂ 2 μ) (y : FullSector μ (n + 1)) :
    symmetrizer μ (n + 1 + 1) (tensorInsertion μ (n + 1) h (symmetrizer μ (n + 1) y)) =
      symmetrizer μ (n + 1 + 1) (tensorInsertion μ (n + 1) h y) := by
  apply sub_eq_zero.mp
  rw [← map_sub, ← map_sub]
  refine eq_zero_of_symmetric μ _ _ (symmetrizer_mem μ _ _) fun z hz => ?_
  rw [inner_symmetrizer_right μ _ z hz,
    ← ContinuousLinearMap.adjoint_inner_left (tensorInsertion μ (n + 1) h), inner_sub_right,
    inner_symmetrizer_right μ _ _ (tensorContraction_symmetric μ (n + 1) h ⟨z, hz⟩), sub_self]

/-- The symmetrizer is invariant under permutations. -/
theorem symmetrizer_permutation (n : ℕ) (π : Equiv.Perm (Fin n)) (w : FullSector μ n) :
    symmetrizer μ n (permutation μ n π w) = symmetrizer μ n w := by
  apply sub_eq_zero.mp
  rw [← map_sub]
  refine eq_zero_of_symmetric μ _ _ (symmetrizer_mem μ _ _) fun z hz => ?_
  have hp : ⟪z, permutation μ n π w⟫_ℂ = ⟪z, w⟫_ℂ := by
    have h := (permutation μ n π).inner_map_map z w
    rw [hz π] at h
    exact h
  rw [inner_symmetrizer_right μ _ z hz, inner_sub_right, hp, sub_self]

private theorem piCongrLeft_apply' {n : ℕ} (π : Equiv.Perm (Fin n)) (k : Fin n → Ω) (i : Fin n) :
    MeasurableEquiv.piCongrLeft (fun _ : Fin n => Ω) π k i = k (π.symm i) := by
  simp [MeasurableEquiv.piCongrLeft, Equiv.piCongrLeft_apply]

/-- Double insertion in the two possible orders differs by the swap of the
first two slots. -/
theorem insertion_swap (n : ℕ) (h f : Lp ℂ 2 μ) (x : FullSector μ n) :
    tensorInsertion μ (n + 1) h (tensorInsertion μ n f x) =
      permutation μ (n + 1 + 1) (Equiv.swap 0 1)
        (tensorInsertion μ (n + 1) f (tensorInsertion μ n h x)) := by
  have hp₂ := measurePreserving_piFinSuccAbove (fun _ : Fin (n + 1 + 1) => μ) 0
  have hp₁ := measurePreserving_piFinSuccAbove (fun _ : Fin (n + 1) => μ) 0
  have hσ := measurePreserving_piCongrLeft (fun _ : Fin (n + 1 + 1) => μ) (Equiv.swap 0 1)
  -- the inner insertions, read at the tail
  have hin₁ := hp₂.quasiMeasurePreserving.ae
    ((Measure.quasiMeasurePreserving_snd (μ := μ)).ae (tensorInsertion_ae μ n f x))
  have hin₂ := hσ.quasiMeasurePreserving.ae (hp₂.quasiMeasurePreserving.ae
    ((Measure.quasiMeasurePreserving_snd (μ := μ)).ae (tensorInsertion_ae μ n h x)))
  have hout₂ := hσ.quasiMeasurePreserving.ae
    (tensorInsertion_ae μ (n + 1) f (tensorInsertion μ n h x))
  apply Lp.ext
  filter_upwards [tensorInsertion_ae μ (n + 1) h (tensorInsertion μ n f x), hin₁,
    permutation_ae μ (n + 1 + 1) (Equiv.swap 0 1)
      (tensorInsertion μ (n + 1) f (tensorInsertion μ n h x)), hout₂, hin₂]
    with k ha hb hc hd he
  rw [ha, hc, Function.comp_apply, hd]
  change (tensorInsertion μ n f x) (fun i => k i.succ) =
    f (k (0 : Fin (n + 1)).succ) * x (fun i => k i.succ.succ) at hb
  change (tensorInsertion μ n h x) (fun i =>
      (MeasurableEquiv.piCongrLeft (fun _ : Fin (n + 1 + 1) => Ω) (Equiv.swap 0 1) k) i.succ) =
    h ((MeasurableEquiv.piCongrLeft (fun _ : Fin (n + 1 + 1) => Ω) (Equiv.swap 0 1) k)
      (0 : Fin (n + 1)).succ) *
      x (fun i => (MeasurableEquiv.piCongrLeft (fun _ : Fin (n + 1 + 1) => Ω)
        (Equiv.swap 0 1) k) i.succ.succ) at he
  rw [hb, he]
  simp only [piCongrLeft_apply', Equiv.symm_swap]
  have h0 : Equiv.swap (0 : Fin (n + 1 + 1)) 1 0 = 1 := Equiv.swap_apply_left _ _
  have h1 : Equiv.swap (0 : Fin (n + 1 + 1)) 1 (Fin.succ 0) = 0 := Equiv.swap_apply_right _ _
  have h2 : ∀ i : Fin n, Equiv.swap (0 : Fin (n + 1 + 1)) 1 i.succ.succ = i.succ.succ := fun i =>
    Equiv.swap_apply_of_ne_of_ne (Fin.succ_ne_zero _) (fun hi => by
      have hv := congrArg Fin.val hi
      simp only [Fin.val_succ, Fin.val_one] at hv
      omega)
  simp only [h0, h1, h2]
  change h (k 0) * (f (k 1) * x (fun i => k i.succ.succ)) =
    f (k 1) * (h (k 0) * x (fun i => k i.succ.succ))
  ring

/-- **Creation operators commute**, `a†(h) a†(f) = a†(f) a†(h)`. -/
theorem creationSector_comm (n : ℕ) (h f : Lp ℂ 2 μ) (x : Sector μ n) :
    creationSector μ (n + 1) h (creationSector μ n f x) =
      creationSector μ (n + 1) f (creationSector μ n h x) := by
  apply Subtype.ext
  simp only [creationSector_val, map_smul]
  rw [symmetrizer_insertion_symmetrizer, symmetrizer_insertion_symmetrizer,
    insertion_swap μ n h f x.val, symmetrizer_permutation]

end Commutation

section Truncation

/-! ### Truncated radiation weights -/

variable (R : ℝ) (hR : 0 ≤ R)

/-- The truncated frequency `min(‖k‖, R)`. -/
def truncatedFrequency (p : PhotonMode) : ℝ := min ‖p.1‖ R

theorem truncatedFrequency_measurable : Measurable (truncatedFrequency R) :=
  measurable_fst.norm.min measurable_const

include hR in
theorem truncatedFrequency_nonneg (p : PhotonMode) : 0 ≤ truncatedFrequency R p :=
  le_min (norm_nonneg _) hR

include hR in
theorem truncatedFrequency_abs_le (p : PhotonMode) : |truncatedFrequency R p| ≤ R := by
  rw [abs_of_nonneg (truncatedFrequency_nonneg R hR p)]
  exact min_le_right _ _

/-- The sector weight `∑ᵢ min(‖kᵢ‖, R)`. -/
def sectorWeight (n : ℕ) (k : Fin n → PhotonMode) : ℝ := ∑ i, truncatedFrequency R (k i)

theorem sectorWeight_measurable (n : ℕ) : Measurable (sectorWeight R n) :=
  Finset.measurable_sum _ fun i _ => (truncatedFrequency_measurable R).comp (measurable_pi_apply i)

include hR in
theorem sectorWeight_nonneg (n : ℕ) (k : Fin n → PhotonMode) : 0 ≤ sectorWeight R n k :=
  Finset.sum_nonneg fun i _ => truncatedFrequency_nonneg R hR (k i)

include hR in
theorem sectorWeight_abs_le (n : ℕ) (k : Fin n → PhotonMode) : |sectorWeight R n k| ≤ n * R := by
  rw [abs_of_nonneg (sectorWeight_nonneg R hR n k)]
  calc sectorWeight R n k ≤ ∑ _i : Fin n, R :=
        Finset.sum_le_sum fun i _ => min_le_right _ _
    _ = n * R := by simp

theorem sectorWeight_succ (n : ℕ) (k : Fin (n + 1) → PhotonMode) :
    sectorWeight R (n + 1) k = truncatedFrequency R (k 0) + sectorWeight R n (fun i => k i.succ) :=
  Fin.sum_univ_succ _

private theorem piCongrLeft_photon {n : ℕ} (π : Equiv.Perm (Fin n)) (k : Fin n → PhotonMode)
    (i : Fin n) : MeasurableEquiv.piCongrLeft (fun _ : Fin n => PhotonMode) π k i = k (π.symm i) := by
  simp [MeasurableEquiv.piCongrLeft, Equiv.piCongrLeft_apply]

theorem sectorWeight_perm (n : ℕ) (π : Equiv.Perm (Fin n)) (k : Fin n → PhotonMode) :
    sectorWeight R n (MeasurableEquiv.piCongrLeft (fun _ : Fin n => PhotonMode) π k) =
      sectorWeight R n k := by
  unfold sectorWeight
  simp only [piCongrLeft_photon]
  exact Equiv.sum_comp π.symm (fun i => truncatedFrequency R (k i))

/-- Multiplication by the truncated sector weight. -/
def sectorMultiplier (n : ℕ) : FullSector photonMeasure n →L[ℂ] FullSector photonMeasure n :=
  PhotonLocalization.realL2Multiplier (sectorWeight R n)
    (sectorWeight_measurable R n).aestronglyMeasurable (n * R)
    (ae_of_all _ (sectorWeight_abs_le R hR n))

/-- Multiplication by the truncated frequency on one-photon functions. -/
def oneMultiplier : Lp ℂ 2 photonMeasure →L[ℂ] Lp ℂ 2 photonMeasure :=
  PhotonLocalization.realL2Multiplier (truncatedFrequency R)
    (truncatedFrequency_measurable R).aestronglyMeasurable R
    (ae_of_all _ (truncatedFrequency_abs_le R hR))

theorem sectorMultiplier_ae (n : ℕ) (v : FullSector photonMeasure n) :
    sectorMultiplier R hR n v =ᵐ[SectorMeasure photonMeasure n] fun k => sectorWeight R n k • v k :=
  PhotonLocalization.realL2Multiplier_apply _ _ _ _ v

theorem oneMultiplier_ae (f : Lp ℂ 2 photonMeasure) :
    oneMultiplier R hR f =ᵐ[photonMeasure] fun p => truncatedFrequency R p • f p :=
  PhotonLocalization.realL2Multiplier_apply _ _ _ _ f

theorem sectorMultiplier_symmetric (n : ℕ) (u v : FullSector photonMeasure n) :
    ⟪sectorMultiplier R hR n u, v⟫_ℂ = ⟪u, sectorMultiplier R hR n v⟫_ℂ :=
  ContinuousLinearMap.isSelfAdjoint_iff_isSymmetric.mp
    (PhotonLocalization.realL2Multiplier_selfadjoint _ _ _ _) u v

theorem sectorMultiplier_permutation (n : ℕ) (π : Equiv.Perm (Fin n))
    (v : FullSector photonMeasure n) :
    sectorMultiplier R hR n (permutation photonMeasure n π v) =
      permutation photonMeasure n π (sectorMultiplier R hR n v) := by
  have hp := measurePreserving_piCongrLeft (fun _ : Fin n => photonMeasure) π
  apply Lp.ext
  filter_upwards [sectorMultiplier_ae R hR n (permutation photonMeasure n π v),
    permutation_ae photonMeasure n π v,
    permutation_ae photonMeasure n π (sectorMultiplier R hR n v),
    hp.quasiMeasurePreserving.ae (sectorMultiplier_ae R hR n v)] with k h₁ h₂ h₃ h₄
  rw [h₁, h₂, h₃, Function.comp_apply, Function.comp_apply, h₄, sectorWeight_perm]

theorem sectorMultiplier_mem (n : ℕ) (v : FullSector photonMeasure n)
    (hv : v ∈ symmetricSubspace photonMeasure n) :
    sectorMultiplier R hR n v ∈ symmetricSubspace photonMeasure n := fun π =>
  (sectorMultiplier_permutation R hR n π v).symm.trans
    (congrArg (sectorMultiplier R hR n) (hv π))

/-- The truncated weight commutes with the symmetrizer. -/
theorem symmetrizer_sectorMultiplier (n : ℕ) (v : FullSector photonMeasure n) :
    symmetrizer photonMeasure n (sectorMultiplier R hR n v) =
      sectorMultiplier R hR n (symmetrizer photonMeasure n v) :=
  PhysicalInvariantProjection.symmetric_projection (symmetricSubspace photonMeasure n)
    (sectorMultiplier R hR n) (sectorMultiplier_symmetric R hR n)
    (sectorMultiplier_mem R hR n) v

/-- The truncated weight on a sector. -/
def sectorWeightOp (n : ℕ) (y : Sector photonMeasure n) : Sector photonMeasure n :=
  ⟨sectorMultiplier R hR n y.val, sectorMultiplier_mem R hR n y.val y.property⟩

theorem sectorWeightOp_val (n : ℕ) (y : Sector photonMeasure n) :
    (sectorWeightOp R hR n y).val = sectorMultiplier R hR n y.val := rfl

/-- The weight of an insertion: `M (f ⊗ x) = (w f) ⊗ x + f ⊗ M x`. -/
theorem sectorMultiplier_insertion (n : ℕ) (f : Lp ℂ 2 photonMeasure)
    (x : FullSector photonMeasure n) :
    sectorMultiplier R hR (n + 1) (tensorInsertion photonMeasure n f x) =
      tensorInsertion photonMeasure n (oneMultiplier R hR f) x +
        tensorInsertion photonMeasure n f (sectorMultiplier R hR n x) := by
  have hp := measurePreserving_piFinSuccAbove (fun _ : Fin (n + 1) => photonMeasure) 0
  have hhead := hp.quasiMeasurePreserving.ae
    ((Measure.quasiMeasurePreserving_fst (ν := SectorMeasure photonMeasure n)).ae
      (oneMultiplier_ae R hR f))
  have htail := hp.quasiMeasurePreserving.ae
    ((Measure.quasiMeasurePreserving_snd (μ := photonMeasure)).ae
      (sectorMultiplier_ae R hR n x))
  apply Lp.ext
  filter_upwards [sectorMultiplier_ae R hR (n + 1) (tensorInsertion photonMeasure n f x),
    tensorInsertion_ae photonMeasure n f x,
    Lp.coeFn_add (tensorInsertion photonMeasure n (oneMultiplier R hR f) x)
      (tensorInsertion photonMeasure n f (sectorMultiplier R hR n x)),
    tensorInsertion_ae photonMeasure n (oneMultiplier R hR f) x,
    tensorInsertion_ae photonMeasure n f (sectorMultiplier R hR n x), hhead, htail]
    with k h₁ h₂ h₃ h₄ h₅ h₆ h₇
  change (oneMultiplier R hR f) (k 0) = truncatedFrequency R (k 0) • f (k 0) at h₆
  change (sectorMultiplier R hR n x) (fun i => k i.succ) =
    sectorWeight R n (fun i => k i.succ) • x (fun i => k i.succ) at h₇
  rw [h₁, h₂, h₃, Pi.add_apply, h₄, h₅, h₆, h₇, sectorWeight_succ]
  simp only [Complex.real_smul]
  push_cast
  ring

/-- **The truncated weight of a created vector**,
`M a†(g) y = a†(w g) y + a†(g) (M y)`. -/
theorem sectorMultiplier_creation (n : ℕ) (g : Lp ℂ 2 photonMeasure) (y : Sector photonMeasure n) :
    sectorMultiplier R hR (n + 1) (creationSector photonMeasure n g y).val =
      (creationSector photonMeasure n (oneMultiplier R hR g) y).val +
        (creationSector photonMeasure n g (sectorWeightOp R hR n y)).val := by
  rw [creationSector_val, creationSector_val, creationSector_val, sectorWeightOp_val, map_smul,
    ← symmetrizer_sectorMultiplier, sectorMultiplier_insertion, map_add, smul_add]

end Truncation

section SoftFree

/-! ### Soft modes and soft-free sectors -/

variable (κ : ℝ)

/-- Soft one-photon functions are orthogonal to hard ones. -/
theorem soft_mem_hard_orthogonal {f : Lp ℂ 2 photonMeasure} (hf : f ∈ softOnePhoton κ) :
    f ∈ (hardOnePhoton κ)ᗮ := by
  rw [Submodule.mem_orthogonal]
  intro h hh
  have hf' := (MomentumSplit.mem_supported_iff photonMeasure (softMomentumSet κ)
    (softMomentumSet_measurable κ) f).mp hf
  have hh' := (MomentumSplit.mem_supported_iff photonMeasure (softMomentumSet κ)ᶜ
    (softMomentumSet_measurable κ).compl h).mp hh
  rw [L2.inner_def]
  apply integral_eq_zero_of_ae
  filter_upwards [hf', hh'] with p h₁ h₂
  by_cases hp : p ∈ softMomentumSet κ
  · rw [h₂ (fun hc => hc hp), inner_zero_left]
    rfl
  · rw [h₁ hp, inner_zero_right]
    rfl

/-- A sector vector annihilated by every soft mode. -/
def SoftFree : (n : ℕ) → Sector photonMeasure n → Prop
  | 0, _ => True
  | m + 1, y => ∀ g ∈ softOnePhoton κ, annihilationSector photonMeasure m g y = 0

include C in
theorem softFree_of_generated (u : PhotonFock) (hu : u ∈ generatedFockSubspace (hardOnePhoton κ))
    (n : ℕ) : SoftFree κ n (u n) := by
  cases n with
  | zero => trivial
  | succ m =>
    exact fun g hg => annihilation_hard C (hardOnePhoton κ) (soft_mem_hard_orthogonal κ hg) hu m

include C in
/-- Tag inner product in one sector, for a soft-free second vector. -/
theorem creation_inner_soft {f g : Lp ℂ 2 photonMeasure} (hf : f ∈ softOnePhoton κ) (n : ℕ)
    (x y : Sector photonMeasure n) (hy : SoftFree κ n y) :
    ⟪creationSector photonMeasure n f x, creationSector photonMeasure n g y⟫_ℂ =
      ⟪f, g⟫_ℂ * ⟪x, y⟫_ℂ := by
  rw [annihilationSector_duality]
  cases n with
  | zero =>
    rw [sectorCCR_vacuum_apply photonMeasure C f g]
    exact inner_smul_right (𝕜 := ℂ) x y ⟪f, g⟫_ℂ
  | succ m =>
    rw [sectorCCR_successor_apply photonMeasure C m f g, hy f hf, map_zero, zero_add]
    exact inner_smul_right (𝕜 := ℂ) x y ⟪f, g⟫_ℂ

variable (R : ℝ) (hR : 0 ≤ R)

theorem oneMultiplier_soft {f : Lp ℂ 2 photonMeasure} (hf : f ∈ softOnePhoton κ) :
    oneMultiplier R hR f ∈ softOnePhoton κ := by
  have hf' := (MomentumSplit.mem_supported_iff photonMeasure (softMomentumSet κ)
    (softMomentumSet_measurable κ) f).mp hf
  apply (MomentumSplit.mem_supported_iff photonMeasure (softMomentumSet κ)
    (softMomentumSet_measurable κ) _).mpr
  filter_upwards [hf', oneMultiplier_ae R hR f] with p h₁ h₂ hp
  rw [h₂, h₁ hp, smul_zero]

/-- The truncated weight keeps a sector vector soft-free. -/
theorem softFree_sectorWeightOp (n : ℕ) (y : Sector photonMeasure n) (hy : SoftFree κ n y) :
    SoftFree κ n (sectorWeightOp R hR n y) := by
  cases n with
  | zero => trivial
  | succ m =>
    intro g hg
    apply ext_inner_left ℂ
    intro z
    rw [inner_zero_right, ← annihilationSector_duality]
    change ⟪(creationSector photonMeasure m g z).val, sectorMultiplier R hR (m + 1) y.val⟫_ℂ = 0
    rw [← sectorMultiplier_symmetric, sectorMultiplier_creation, inner_add_left]
    change ⟪creationSector photonMeasure m (oneMultiplier R hR g) z, y⟫_ℂ +
      ⟪creationSector photonMeasure m g (sectorWeightOp R hR m z), y⟫_ℂ = 0
    rw [annihilationSector_duality, annihilationSector_duality,
      hy _ (oneMultiplier_soft κ R hR hg), hy g hg, inner_zero_right, inner_zero_right, add_zero]

include C in
/-- **Truncated radiation of tags in one sector**,
`⟪a†f x, M a†g y⟫ = ⟪f, w g⟫ ⟪x, y⟫ + ⟪f, g⟫ ⟪x, M y⟫`. -/
theorem inner_multiplier_creation {f g : Lp ℂ 2 photonMeasure} (hf : f ∈ softOnePhoton κ)
    (n : ℕ) (x y : Sector photonMeasure n) (hy : SoftFree κ n y) :
    ⟪(creationSector photonMeasure n f x).val,
        sectorMultiplier R hR (n + 1) (creationSector photonMeasure n g y).val⟫_ℂ =
      ⟪f, oneMultiplier R hR g⟫_ℂ * ⟪x, y⟫_ℂ + ⟪f, g⟫_ℂ * ⟪x, sectorWeightOp R hR n y⟫_ℂ := by
  rw [sectorMultiplier_creation, inner_add_right]
  exact congrArg₂ (· + ·) (creation_inner_soft C κ hf n x y hy)
    (creation_inner_soft C κ hf n x _ (softFree_sectorWeightOp κ R hR n y hy))

end SoftFree

section RadiationLimit

/-! ### The radiation form as a supremum of truncated forms -/

theorem iSup_ofReal_sectorWeight (n : ℕ) (k : Fin n → PhotonMode) :
    ⨆ r : ℕ, ENNReal.ofReal (sectorWeight r n k) = ENNReal.ofReal (sectorDispersion n k) := by
  apply le_antisymm
  · refine iSup_le fun r => ENNReal.ofReal_le_ofReal ?_
    exact Finset.sum_le_sum fun i _ => min_le_left _ _
  · refine le_iSup_of_le ⌈sectorDispersion n k⌉₊ (ENNReal.ofReal_le_ofReal ?_)
    refine (Finset.sum_le_sum fun i _ => ?_).trans_eq rfl
    refine le_min le_rfl ?_
    exact ((Finset.single_le_sum (f := fun j => ‖(k j).1‖) (fun j _ => norm_nonneg _)
      (Finset.mem_univ i)).trans (le_refl (sectorDispersion n k))).trans (Nat.le_ceil _)

private theorem inner_real_smul_self (r : ℝ) (z : ℂ) :
    ⟪z, r • z⟫_ℂ = ((r * ‖z‖ ^ 2 : ℝ) : ℂ) := by
  rw [RCLike.inner_apply, Complex.real_smul, mul_assoc, Complex.mul_conj',
    Complex.ofReal_mul, Complex.ofReal_pow]

variable (R : ℝ) (hR : 0 ≤ R)

theorem ofReal_inner_sectorMultiplier (n : ℕ) (v : FullSector photonMeasure n) :
    ENNReal.ofReal (⟪v, sectorMultiplier R hR n v⟫_ℂ).re =
      ∫⁻ k, ENNReal.ofReal (sectorWeight R n k) * ENNReal.ofReal (‖v k‖ ^ 2)
        ∂SectorMeasure photonMeasure n := by
  have hsq : Integrable (fun k => ‖v k‖ ^ 2) (SectorMeasure photonMeasure n) :=
    (memLp_two_iff_integrable_sq_norm (Lp.aestronglyMeasurable v)).mp (Lp.memLp v)
  have hint : Integrable (fun k => sectorWeight R n k * ‖v k‖ ^ 2)
      (SectorMeasure photonMeasure n) :=
    hsq.bdd_mul (sectorWeight_measurable R n).aestronglyMeasurable
      (ae_of_all _ fun k => (Real.norm_eq_abs _).trans_le (sectorWeight_abs_le R hR n k))
  have hi : ⟪v, sectorMultiplier R hR n v⟫_ℂ =
      ((∫ k, sectorWeight R n k * ‖v k‖ ^ 2 ∂SectorMeasure photonMeasure n : ℝ) : ℂ) := by
    rw [L2.inner_def, ← integral_complex_ofReal]
    apply integral_congr_ae
    filter_upwards [sectorMultiplier_ae R hR n v] with k hk
    rw [hk]
    exact inner_real_smul_self _ _
  rw [hi, Complex.ofReal_re, ofReal_integral_eq_lintegral_ofReal hint
    (ae_of_all _ fun k => mul_nonneg (sectorWeight_nonneg R hR n k) (sq_nonneg _))]
  apply lintegral_congr
  intro k
  exact ENNReal.ofReal_mul (sectorWeight_nonneg R hR n k)

/-- **The radiation form is the supremum of the truncated forms.** -/
theorem sectorRadiationForm_eq_iSup (n : ℕ) (v : Sector photonMeasure n) :
    sectorRadiationForm n v =
      ⨆ r : ℕ, ENNReal.ofReal
        (⟪v.val, sectorMultiplier (r : ℝ) (Nat.cast_nonneg r) n v.val⟫_ℂ).re := by
  simp_rw [ofReal_inner_sectorMultiplier]
  have hmeas : ∀ r : ℕ, Measurable (fun k => ENNReal.ofReal (sectorWeight (r : ℝ) n k) *
      ENNReal.ofReal (‖(v.val : FullSector photonMeasure n) k‖ ^ 2)) := fun r =>
    (sectorWeight_measurable (r : ℝ) n).ennreal_ofReal.mul
      ((Lp.stronglyMeasurable (v.val : FullSector photonMeasure n)).measurable.norm.pow_const
        2).ennreal_ofReal
  have hmono : Monotone (fun (r : ℕ) k => ENNReal.ofReal (sectorWeight (r : ℝ) n k) *
      ENNReal.ofReal (‖(v.val : FullSector photonMeasure n) k‖ ^ 2)) := by
    intro r s hrs k
    refine mul_le_mul_left (ENNReal.ofReal_le_ofReal ?_) _
    exact Finset.sum_le_sum fun i _ => min_le_min le_rfl (Nat.cast_le.mpr hrs)
  rw [← lintegral_iSup hmeas hmono]
  unfold sectorRadiationForm
  apply lintegral_congr
  intro k
  rw [← ENNReal.iSup_mul, iSup_ofReal_sectorWeight]

end RadiationLimit

section Tag

/-- Coordinates of the tagged vector `a†(f) u`. -/
def tagCoordinates (f : Lp ℂ 2 photonMeasure) (u : PhotonFock) : (n : ℕ) → Sector photonMeasure n
  | 0 => 0
  | n + 1 => creationSector photonMeasure n f (u n)

@[simp] theorem tagCoordinates_zero (f : Lp ℂ 2 photonMeasure) (u : PhotonFock) :
    tagCoordinates f u 0 = 0 := rfl

@[simp] theorem tagCoordinates_succ (f : Lp ℂ 2 photonMeasure) (u : PhotonFock) (n : ℕ) :
    tagCoordinates f u (n + 1) = creationSector photonMeasure n f (u n) := rfl

variable {f g : Lp ℂ 2 photonMeasure}

include C in
theorem tagCoordinates_memℓp (hf : f ∈ Vᗮ) (u : PhotonFock) (hu : u ∈ generatedFockSubspace V) :
    Memℓp (tagCoordinates f u) 2 := by
  have hs : Summable (fun n => ‖u n‖ ^ 2) := by
    have h := (lp.memℓp u).summable (by norm_num : 0 < (2 : ℝ≥0∞).toReal)
    simpa only [ENNReal.toReal_ofNat, Real.rpow_two] using h
  have ht : Summable (fun n => ‖tagCoordinates f u n‖ ^ 2) := by
    apply (summable_nat_add_iff 1).mp
    refine (hs.mul_left (‖f‖ ^ 2)).congr fun n => ?_
    exact (creation_norm_sq C V hf hu n).symm
  exact memℓp_gen (by simpa only [ENNReal.toReal_ofNat, Real.rpow_two] using ht)

/-- The tagged vector `a†(f) u` of a hard Fock vector `u`. -/
def tag (hf : f ∈ Vᗮ) (u : generatedFockSubspace V) : PhotonFock :=
  ⟨tagCoordinates f u.val, tagCoordinates_memℓp C V hf u.val u.property⟩

theorem tag_zero_coord (hf : f ∈ Vᗮ) (u : generatedFockSubspace V) : tag C V hf u 0 = 0 := rfl

theorem tag_succ_coord (hf : f ∈ Vᗮ) (u : generatedFockSubspace V) (n : ℕ) :
    tag C V hf u (n + 1) = creationSector photonMeasure n f (u.val n) := rfl

theorem tag_add (hf : f ∈ Vᗮ) (u v : generatedFockSubspace V) :
    tag C V hf (u + v) = tag C V hf u + tag C V hf v := by
  apply lp.ext
  funext n
  cases n with
  | zero => exact (add_zero 0).symm
  | succ n => exact map_add (creationSector photonMeasure n f) (u.val n) (v.val n)

theorem tag_smul (hf : f ∈ Vᗮ) (c : ℂ) (u : generatedFockSubspace V) :
    tag C V hf (c • u) = c • tag C V hf u := by
  apply lp.ext
  funext n
  cases n with
  | zero => exact (smul_zero c).symm
  | succ n => exact map_smul (creationSector photonMeasure n f) c (u.val n)

/-- The tag map as a linear map on the hard Fock space. -/
def tagMap (hf : f ∈ Vᗮ) : generatedFockSubspace V →ₗ[ℂ] PhotonFock where
  toFun := tag C V hf
  map_add' := tag_add C V hf
  map_smul' := tag_smul C V hf

theorem tagMap_apply (hf : f ∈ Vᗮ) (u : generatedFockSubspace V) :
    tagMap C V hf u = tag C V hf u := rfl

/-- **Inner products of tags**, `⟪a†(f) u, a†(g) v⟫ = ⟪f, g⟫ ⟪u, v⟫`. -/
theorem tag_inner (hf : f ∈ Vᗮ) (hg : g ∈ Vᗮ) (u v : generatedFockSubspace V) :
    ⟪tag C V hf u, tag C V hg v⟫_ℂ = ⟪f, g⟫_ℂ * ⟪(u : PhotonFock), (v : PhotonFock)⟫_ℂ := by
  exact shifted_inner (u : PhotonFock) (v : PhotonFock) (tag C V hf u) (tag C V hg v) rfl ⟪f, g⟫_ℂ
    (fun n => creation_inner C V hf v.property n)

/-- **Tags are orthogonal to hard vectors.** -/
theorem tag_inner_hard (hf : f ∈ Vᗮ) (u : generatedFockSubspace V) (w : PhotonFock)
    (hw : w ∈ generatedFockSubspace V) :
    ⟪tag C V hf u, w⟫_ℂ = 0 := by
  refine coordinate_inner_zero (tag C V hf u) w fun n => ?_
  cases n with
  | zero => exact inner_zero_left _
  | succ n => exact creation_inner_hard C V hf hw n

theorem tag_norm_sq (hf : f ∈ Vᗮ) (u : generatedFockSubspace V) :
    ‖tag C V hf u‖ ^ 2 = ‖f‖ ^ 2 * ‖(u : PhotonFock)‖ ^ 2 := by
  have h := tag_inner C V hf hf u u
  rw [inner_self_eq_norm_sq_to_K, inner_self_eq_norm_sq_to_K, inner_self_eq_norm_sq_to_K] at h
  exact_mod_cast h

end Tag

