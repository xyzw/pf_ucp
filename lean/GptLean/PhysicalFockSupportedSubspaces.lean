import GptLean.PhysicalFockExponential
import GptLean.PhotonLocalizationFockSupport

/-!
Fock subspaces and channel support derived from the matched exponential law.

The subspace is the closed span of the actual finite creation words with
kernels in the given one-photon subspace. The split-word formula puts each
retained tensor factor there. Environmental coefficients and density then
prove the support statement for every Fock vector.
-/

noncomputable section
namespace GptLean.PhysicalFock

open MeasureTheory Filter Topology
open scoped ENNReal
open PhotonLocalizationFockChannel


section Generic
variable {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) [SigmaFinite μ]

/-- The actual completed Fock subspace generated by one-photon kernels in `V`. -/
def generatedSubspace (V : Submodule ℂ (Lp ℂ 2 μ)) : Submodule ℂ (Fock μ) :=
  (Submodule.span ℂ {v | ∃ w : List (Lp ℂ 2 μ),
    (∀ f ∈ w, f ∈ V) ∧ v = creationWord μ w}).topologicalClosure

theorem creationWord_mem_generated (V : Submodule ℂ (Lp ℂ 2 μ))
    (w : List (Lp ℂ 2 μ)) (hw : ∀ f ∈ w, f ∈ V) :
    creationWord μ w ∈ generatedSubspace μ V :=
  (Submodule.le_topologicalClosure _)
    (Submodule.subset_span ⟨w, hw, rfl⟩)

omit [SigmaFinite μ] in
private theorem splitAssignments_retained_mem
    (j : Lp ℂ 2 μ →ₗᵢ[ℂ]
      WithLp 2 (Lp ℂ 2 μ × Lp ℂ 2 μ))
    (V : Submodule ℂ (Lp ℂ 2 μ)) (hV : ∀ f, retainedMap j f ∈ V)
    (w : List (Lp ℂ 2 μ)) :
    ∀ p ∈ splitAssignments μ j w, ∀ f ∈ p.1, f ∈ V := by
  induction w with
  | nil => simp [splitAssignments]
  | cons g w ih =>
    intro p hp
    simp only [splitAssignments, List.mem_append, List.mem_map] at hp
    rcases hp with ⟨q, hq, rfl⟩ | ⟨q, hq, rfl⟩
    · intro f hf
      rcases List.mem_cons.mp hf with rfl | hf
      · exact hV g
      · exact ih q hq f hf
    · exact ih q hq

variable (B : ConcreteExponentialLaw μ)
  (W : TensorCoordinates.TensorSpace (Fock μ) (Fock μ) →ₗᵢ[ℂ]
    lp (fun _ : ℕ => Fock μ) 2)
  (hW : ∀ (V : Submodule ℂ (Fock μ)) (v : Fock μ), v ∈ V →
    ∀ (w : Fock μ) (a : ℕ), W (TensorCoordinates.tensor v w) a ∈ V)

include hW in
private theorem factor_word_mem_generated
    (j : Lp ℂ 2 μ →ₗᵢ[ℂ]
      WithLp 2 (Lp ℂ 2 μ × Lp ℂ 2 μ))
    (V : Submodule ℂ (Lp ℂ 2 μ)) (hV : ∀ f, retainedMap j f ∈ V)
    (w : List (Lp ℂ 2 μ)) (a : ℕ) :
    (B.factorization μ W).factor j (creationWord μ w) a ∈ generatedSubspace μ V := by
  let A := (lp.evalCLM ℂ (fun _ : ℕ => Fock μ) 2 a).comp
    W.toContinuousLinearMap
  have hw := congrArg (fun z : lp (fun _ : ℕ => Fock μ) 2 => z a)
    (B.factorization_word μ W j w)
  suffices h : A (splitCreationTensor μ j w) ∈ generatedSubspace μ V from
    hw.symm ▸ h
  rw [splitCreationTensor, map_list_sum]
  apply list_sum_mem
  intro u hu
  obtain ⟨v, hv, rfl⟩ := List.mem_map.mp hu
  obtain ⟨p, hp, rfl⟩ := List.mem_map.mp hv
  exact hW (generatedSubspace μ V)
    (creationWord μ p.1)
    (creationWord_mem_generated μ V p.1 (splitAssignments_retained_mem μ j V hV w p hp))
    (creationWord μ p.2) a

include hW in
/-- The actual retained Fock support follows from tensor coordinates and creation-word density. -/
theorem factor_mem_generated
    (j : Lp ℂ 2 μ →ₗᵢ[ℂ]
      WithLp 2 (Lp ℂ 2 μ × Lp ℂ 2 μ))
    (V : Submodule ℂ (Lp ℂ 2 μ)) (hV : ∀ f, retainedMap j f ∈ V)
    (u : Fock μ) (a : ℕ) :
    (B.factorization μ W).factor j u a ∈ generatedSubspace μ V := by
  let A := (lp.evalCLM ℂ (fun _ : ℕ => Fock μ) 2 a).comp
    ((B.factorization μ W).factor j).toContinuousLinearMap
  let M := (generatedSubspace μ V).comap A.toLinearMap
  have hspan : Submodule.span ℂ (Set.range (creationWord μ)) ≤ M := by
    apply Submodule.span_le.mpr
    rintro v ⟨w, rfl⟩
    exact factor_word_mem_generated μ B W hW j V hV w a
  have hclosed : IsClosed (M : Set (Fock μ)) :=
    (Submodule.isClosed_topologicalClosure _).preimage A.continuous
  exact (closure_minimal hspan hclosed) (B.words_total u)

end Generic

/-- The generated subspace on the fixed physical photon model. -/
abbrev generatedFockSubspace (V : Submodule ℂ (Lp ℂ 2 photonMeasure)) :
    Submodule ℂ PhotonFock := generatedSubspace photonMeasure V

variable (B : StandardSymmetricFockExponential)

/-- This fills the existing support interface on the same constructed physical channel. -/
def physicalFockSubspaces : FockSubspaces (photonFactorization B) where
  fockSubspace := generatedFockSubspace
  factor_mem j V hV u a := factor_mem_generated photonMeasure (photonExponential B)
    (environmentalCoordinates PhotonFock) environmentalCoordinates_tensor_mem j V hV u a

end GptLean.PhysicalFock
