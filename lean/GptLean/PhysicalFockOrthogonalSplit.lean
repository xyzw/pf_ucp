import GptLean.PhysicalPhotonHardSoft
import GptLean.PhysicalFockSplitContraction

/-!
Surjectivity of the concrete Fock split for complementary momentum supports.

The matched exponential law supplies only an isometry. Its creation-word
formula proves the exact tensor product formula on a soft word followed by
a hard word. Density and closed range then identify the entire image with
the completed tensor product generated by the two supported Fock spaces.
-/

noncomputable section

namespace GptLean.PhysicalFock

open MeasureTheory PhotonLocalizationFockChannel Filter Topology
open TensorCoordinates
open scoped ENNReal InnerProductSpace

set_option Elab.async false
set_option backward.isDefEq.respectTransparency.types false

section TensorHelpers

variable {H K E F Z : Type*}
  [NormedAddCommGroup H] [InnerProductSpace ℂ H]
  [NormedAddCommGroup K] [InnerProductSpace ℂ K]
  [NormedAddCommGroup E] [InnerProductSpace ℂ E]
  [NormedAddCommGroup F] [InnerProductSpace ℂ F]
  [NormedAddCommGroup Z] [NormedSpace ℂ Z]

private def secondTensorMap (A : K →L[ℂ] K) :
    TensorSpace H K →L[ℂ] TensorSpace H K := (A.lTensor H).completion

private theorem secondTensorMap_tensor (A : K →L[ℂ] K) (u : H) (v : K) :
    secondTensorMap A (tensor u v) = tensor u (A v) := by
  rw [tensor_apply, secondTensorMap, ContinuousLinearMap.completion_apply_coe]
  rfl

private theorem tensor_clm_ext (A B : TensorSpace H K →L[ℂ] Z)
    (h : ∀ u v, A (tensor u v) = B (tensor u v)) : A = B := by
  apply ContinuousLinearMap.ext
  intro z
  induction z using UniformSpace.Completion.induction_on with
  | hp => exact isClosed_eq A.continuous B.continuous
  | ih z =>
    induction z using TensorProduct.induction_on with
    | zero => simp only [UniformSpace.Completion.coe_zero, map_zero]
    | tmul u v => exact h u v
    | add z w hz hw =>
      simpa only [UniformSpace.Completion.coe_add, map_add] using (congrArg₂ (· + ·) hz hw)

private theorem retained_tensor_of_eq (A : H →L[ℂ] H)
    (u u' : H) (v : K) (h : A u = u') :
    retainedOperator A (tensor u v) = tensor u' v :=
  (retainedOperator_tensor A u v).trans (congrArg (tensor.flip v) h)

private theorem discarded_tensor_of_eq (A : K →L[ℂ] K)
    (u : H) (v v' : K) (h : A v = v') :
    secondTensorMap A (tensor u v) = tensor u v' :=
  (secondTensorMap_tensor A u v).trans (congrArg (tensor u) h)

private theorem secondTensorMap_zero :
    secondTensorMap (H := H) (0 : K →L[ℂ] K) = 0 := by
  apply tensor_clm_ext
  intro u v
  rw [secondTensorMap_tensor]
  exact (tensor u).map_zero

private theorem firstTensorMap_zero :
    retainedOperator (K := K) (0 : H →L[ℂ] H) = 0 := by
  apply tensor_clm_ext
  intro u v
  rw [retainedOperator_tensor]
  exact (tensor.flip v).map_zero

private theorem tensor_step_second (A : H →L[ℂ] H) (B : K →L[ℂ] K)
    (x : TensorSpace H K) (u : H) (v v' : K)
    (hA : A = 0) (hx : x = tensor u v) (hB : B v = v') :
    retainedOperator A x + secondTensorMap B x = tensor u v' := by
  rw [hA, firstTensorMap_zero, zero_apply, zero_add, hx]
  exact discarded_tensor_of_eq B u v v' hB

private theorem tensor_step_first (A : H →L[ℂ] H) (B : K →L[ℂ] K)
    (x : TensorSpace H K) (u u' : H) (v : K)
    (hB : B = 0) (hx : x = tensor u v) (hA : A u = u') :
    retainedOperator A x + secondTensorMap B x = tensor u' v := by
  rw [hB, secondTensorMap_zero, zero_apply, add_zero, hx]
  exact retained_tensor_of_eq A u u' v hA

private def completedTensorMap (U : H →ₗᵢ[ℂ] E) (V : K →ₗᵢ[ℂ] F) :
    TensorSpace H K →ₗᵢ[ℂ] TensorSpace E F := (TensorProduct.mapIsometry U V).completion

private theorem completedTensorMap_tensor (U : H →ₗᵢ[ℂ] E) (V : K →ₗᵢ[ℂ] F)
    (u : H) (v : K) : completedTensorMap U V (tensor u v) = tensor (U u) (V v) := by
  rw [tensor_apply, completedTensorMap, LinearIsometry.completion_apply_coe]
  rfl

private theorem tensor_clm_mem (U : TensorSpace H K →L[ℂ] Z)
    (M : Submodule ℂ Z) (hM : IsClosed (M : Set Z))
    (h : ∀ u v, U (tensor u v) ∈ M) (z : TensorSpace H K) : U z ∈ M := by
  induction z using UniformSpace.Completion.induction_on with
  | hp => exact hM.preimage U.continuous
  | ih z =>
    induction z using TensorProduct.induction_on with
    | zero => simpa only [UniformSpace.Completion.coe_zero, map_zero] using M.zero_mem
    | tmul u v => exact h u v
    | add z w hz hw => simpa only [UniformSpace.Completion.coe_add, map_add] using M.add_mem hz hw

private theorem clm_mem_of_spanClosure (U : H →L[ℂ] Z) (M : Submodule ℂ Z)
    (hM : IsClosed (M : Set Z)) (S : Set H)
    (h : ∀ u ∈ S, U u ∈ M) (u : H) (hu : u ∈ (Submodule.span ℂ S).topologicalClosure) :
    U u ∈ M := by
  let P := M.comap U.toLinearMap
  have hp : IsClosed (P : Set H) := hM.preimage U.continuous
  have hspan : Submodule.span ℂ S ≤ P := Submodule.span_le.mpr h
  exact (closure_minimal hspan hp) hu

private theorem tensor_spanClosure_mem (M : Submodule ℂ (TensorSpace H K))
    (hM : IsClosed (M : Set (TensorSpace H K))) (S : Set H) (T : Set K)
    (h : ∀ u ∈ S, ∀ v ∈ T, tensor u v ∈ M)
    (u : H) (hu : u ∈ (Submodule.span ℂ S).topologicalClosure)
    (v : K) (hv : v ∈ (Submodule.span ℂ T).topologicalClosure) : tensor u v ∈ M := by
  apply clm_mem_of_spanClosure (tensor.flip v) M hM S _ u hu
  intro w hw
  exact clm_mem_of_spanClosure (tensor w) M hM T (h w hw) v hv

end TensorHelpers

section RangeHelpers

variable {H K Z : Type*}
  [NormedAddCommGroup H] [NormedSpace ℂ H]
  [NormedAddCommGroup K] [NormedSpace ℂ K]
  [NormedAddCommGroup Z] [NormedSpace ℂ Z]

private def equivalenceOfRange (U : H →ₗᵢ[ℂ] Z) (V : K →ₗᵢ[ℂ] Z)
    (h : U.toLinearMap.range = V.toLinearMap.range) : H ≃ₗᵢ[ℂ] K :=
  U.equivRange.trans ((LinearIsometryEquiv.ofEq _ _ h).trans V.equivRange.symm)

private theorem equivalenceOfRange_embedding (U : H →ₗᵢ[ℂ] Z) (V : K →ₗᵢ[ℂ] Z)
    (h : U.toLinearMap.range = V.toLinearMap.range) (u : H) :
    V (equivalenceOfRange U V h u) = U u := by
  change (V.equivRange (V.equivRange.symm _) : Z) = _
  rw [LinearIsometryEquiv.apply_symm_apply]
  rfl

end RangeHelpers

private theorem zero_of_smul_law {E F : Type*}
    [AddCommMonoid E] [Module ℂ E] [AddCommMonoid F] [Module ℂ F]
    (f : E → F) (h : ∀ (x : E) (c : ℂ), f (c • x) = c • f x) : f 0 = 0 := by
  simpa only [zero_smul] using h 0 0

private theorem map_evaluated_list {α H K : Type*}
    [NormedAddCommGroup H] [NormedSpace ℂ H]
    [NormedAddCommGroup K] [NormedSpace ℂ K]
    (A : H →L[ℂ] K) (l : List α) (p : α → H) (q : α → K)
    (h : ∀ x ∈ l, A (p x) = q x) : A ((l.map p).sum) = (l.map q).sum := by
  rw [map_list_sum]
  apply congrArg List.sum
  simp only [List.map_map]
  exact List.map_congr_left h

private theorem evaluated_list_mem {α H : Type*} [AddCommMonoid H] [Module ℂ H]
    (M : Submodule ℂ H) (l : List α) (f : α → H) (h : ∀ x ∈ l, f x ∈ M) :
    (l.map f).sum ∈ M := by
  apply list_sum_mem
  intro z hz
  obtain ⟨x, hx, rfl⟩ := List.mem_map.mp hz
  exact h x hx

variable {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) [SigmaFinite μ]

section FiniteAlgebra
omit [SigmaFinite μ]
variable {E : Type*} [AddCommMonoid E]

private def splitSum
    (j : Lp ℂ 2 μ →ₗᵢ[ℂ] WithLp 2 (Lp ℂ 2 μ × Lp ℂ 2 μ))
    (w : List (Lp ℂ 2 μ)) (T : List (Lp ℂ 2 μ) × List (Lp ℂ 2 μ) → E) : E :=
  ((splitAssignments μ j w).map T).sum

private theorem splitSum_cons
    (j : Lp ℂ 2 μ →ₗᵢ[ℂ] WithLp 2 (Lp ℂ 2 μ × Lp ℂ 2 μ))
    (g : Lp ℂ 2 μ) (w : List (Lp ℂ 2 μ))
    (T : List (Lp ℂ 2 μ) × List (Lp ℂ 2 μ) → E) :
    splitSum μ j (g :: w) T =
      splitSum μ j w (fun p => T (retainedMap j g :: p.1, p.2)) +
      splitSum μ j w (fun p => T (p.1, discardedMap μ j g :: p.2)) := by
  simp [splitSum, splitAssignments, List.map_map, Function.comp_def]

end FiniteAlgebra

private theorem creationSector_zero_kernel (n : ℕ) : creationSector μ n 0 = 0 :=
  zero_of_smul_law (creationSector μ n) (creationSector_smul μ n)

private theorem creationFinite_zero_kernel (M : ℕ) : creationFinite μ M 0 = 0 := by
  classical
  simp only [creationFinite, creationBlock, creationSector_zero_kernel,
    ContinuousLinearMap.zero_comp, ContinuousLinearMap.comp_zero, Finset.sum_const_zero]

/-- The actual bounded action on the second factor of the completed tensor. -/
def discardedTensorOperator (A : Fock μ →L[ℂ] Fock μ) :
    TensorSpace (Fock μ) (Fock μ) →L[ℂ] TensorSpace (Fock μ) (Fock μ) :=
  secondTensorMap A

theorem discardedTensorOperator_tensor (A : Fock μ →L[ℂ] Fock μ)
    (u v : Fock μ) : discardedTensorOperator μ A (tensor u v) = tensor u (A v) :=
  secondTensorMap_tensor A u v

private theorem discardedTensorOperator_zero :
    discardedTensorOperator μ 0 = 0 := secondTensorMap_zero

private theorem retainedTensorOperator_zero :
    retainedOperator (K := Fock μ) (0 : Fock μ →L[ℂ] Fock μ) = 0 := firstTensorMap_zero

theorem splitCreationTensor_cons
    (j : Lp ℂ 2 μ →ₗᵢ[ℂ] WithLp 2 (Lp ℂ 2 μ × Lp ℂ 2 μ))
    (g : Lp ℂ 2 μ) (w : List (Lp ℂ 2 μ)) :
    splitCreationTensor μ j (g :: w) =
      retainedOperator (creationFinite μ w.length (retainedMap j g))
        (splitCreationTensor μ j w) +
      discardedTensorOperator μ (creationFinite μ w.length (discardedMap μ j g))
        (splitCreationTensor μ j w) := by
  let T := fun p : List (Lp ℂ 2 μ) × List (Lp ℂ 2 μ) =>
    tensor (creationWord μ p.1) (creationWord μ p.2)
  have hfirst : retainedOperator (creationFinite μ w.length (retainedMap j g))
      (splitCreationTensor μ j w) =
        splitSum μ j w (fun p => T (retainedMap j g :: p.1, p.2)) := by
    apply map_evaluated_list
    intro p hp
    have h := splitAssignments_lengths μ j w p hp
    exact retained_tensor_of_eq _ _ _ (creationWord μ p.2)
      (creationFinite_word μ w.length (retainedMap j g) p.1 (by omega))
  have hsecond : discardedTensorOperator μ (creationFinite μ w.length (discardedMap μ j g))
      (splitCreationTensor μ j w) =
        splitSum μ j w (fun p => T (p.1, discardedMap μ j g :: p.2)) := by
    apply map_evaluated_list
    intro p hp
    have h := splitAssignments_lengths μ j w p hp
    exact discarded_tensor_of_eq _ (creationWord μ p.1) _ _
      (creationFinite_word μ w.length (discardedMap μ j g) p.2 (by omega))
  exact (splitSum_cons μ j g w T).trans (congrArg₂ (· + ·) hfirst.symm hsecond.symm)

variable (s : Set Ω) (hs : MeasurableSet s)

private theorem split_hard_word (w : List (Lp ℂ 2 μ))
    (hw : ∀ f ∈ w, f ∈ MomentumSplit.supported μ sᶜ hs.compl) :
    splitCreationTensor μ (MomentumSplit.split μ s hs) w =
      tensor (creationWord μ []) (creationWord μ w) := by
  induction w with
  | nil => exact splitCreationTensor_nil μ _
  | cons f w ih =>
    have hf := hw f (List.mem_cons_self ..)
    have hret : retainedMap (MomentumSplit.split μ s hs) f = 0 := by
      have h : MomentumSplit.projection μ sᶜᶜ hs.compl.compl f = 0 := hf
      simpa only [compl_compl, MomentumSplit.retained_split] using h
    have hdis : discardedMap μ (MomentumSplit.split μ s hs) f = f :=
      MomentumSplit.projection_of_supported μ sᶜ hs.compl ⟨f, hf⟩
    have hzero : creationFinite μ w.length (retainedMap (MomentumSplit.split μ s hs) f) = 0 :=
      (congrArg (creationFinite μ w.length) hret).trans (creationFinite_zero_kernel μ w.length)
    have hstep : creationFinite μ w.length (discardedMap μ (MomentumSplit.split μ s hs) f)
        (creationWord μ w) = creationWord μ (f :: w) :=
      (congrArg (fun g => creationFinite μ w.length g (creationWord μ w)) hdis).trans
        (creationFinite_word μ w.length f w le_rfl)
    exact (splitCreationTensor_cons μ (MomentumSplit.split μ s hs) f w).trans
      (tensor_step_second _ _ _ _ _ _ hzero
        (ih (fun g hg => hw g (List.mem_cons_of_mem f hg))) hstep)

/-- The split of concatenated supported words is the corresponding pure tensor. -/
theorem splitCreationTensor_append_supported (u v : List (Lp ℂ 2 μ))
    (hu : ∀ f ∈ u, f ∈ MomentumSplit.supported μ s hs)
    (hv : ∀ f ∈ v, f ∈ MomentumSplit.supported μ sᶜ hs.compl) :
    splitCreationTensor μ (MomentumSplit.split μ s hs) (u ++ v) =
      tensor (creationWord μ u) (creationWord μ v) := by
  induction u with
  | nil => exact split_hard_word μ s hs v hv
  | cons f u ih =>
    have hf := hu f (List.mem_cons_self ..)
    have hret : retainedMap (MomentumSplit.split μ s hs) f = f :=
      MomentumSplit.projection_of_supported μ s hs ⟨f, hf⟩
    have hdis : discardedMap μ (MomentumSplit.split μ s hs) f = 0 := hf
    have hzero : creationFinite μ (u ++ v).length
        (discardedMap μ (MomentumSplit.split μ s hs) f) = 0 :=
      (congrArg (creationFinite μ (u ++ v).length) hdis).trans
        (creationFinite_zero_kernel μ (u ++ v).length)
    have hstep : creationFinite μ (u ++ v).length
        (retainedMap (MomentumSplit.split μ s hs) f) (creationWord μ u) =
        creationWord μ (f :: u) :=
      (congrArg (fun g => creationFinite μ (u ++ v).length g (creationWord μ u)) hret).trans
        (creationFinite_word μ (u ++ v).length f u (by simp))
    exact (splitCreationTensor_cons μ (MomentumSplit.split μ s hs) f (u ++ v)).trans
      (tensor_step_first _ _ _ _ _ _ hzero
        (ih (fun g hg => hu g (List.mem_cons_of_mem f hg))) hstep)

/-- The concrete completed supported tensor space inside the ambient tensor. -/
def supportedTensor : Submodule ℂ (TensorSpace (Fock μ) (Fock μ)) :=
  (Submodule.span ℂ {z | ∃ u v : List (Lp ℂ 2 μ),
    (∀ f ∈ u, f ∈ MomentumSplit.supported μ s hs) ∧
    (∀ f ∈ v, f ∈ MomentumSplit.supported μ sᶜ hs.compl) ∧
    z = tensor (creationWord μ u) (creationWord μ v)}).topologicalClosure

omit [SigmaFinite μ] in
private theorem assignments_supported (w : List (Lp ℂ 2 μ)) :
    ∀ p ∈ splitAssignments μ (MomentumSplit.split μ s hs) w,
      (∀ f ∈ p.1, f ∈ MomentumSplit.supported μ s hs) ∧
      (∀ f ∈ p.2, f ∈ MomentumSplit.supported μ sᶜ hs.compl) := by
  induction w with
  | nil => simp [splitAssignments]
  | cons f w ih =>
    intro p hp
    simp only [splitAssignments, List.mem_append, List.mem_map] at hp
    rcases hp with ⟨q, hq, rfl⟩ | ⟨q, hq, rfl⟩
    · refine ⟨?_, (ih q hq).2⟩
      intro g hg
      rcases List.mem_cons.mp hg with rfl | hg
      · exact MomentumSplit.projection_mem_supported μ s hs f
      · exact (ih q hq).1 g hg
    · refine ⟨(ih q hq).1, ?_⟩
      intro g hg
      rcases List.mem_cons.mp hg with rfl | hg
      · exact MomentumSplit.projection_mem_supported μ sᶜ hs.compl f
      · exact (ih q hq).2 g hg

variable (B : ConcreteExponentialLaw μ)

theorem split_mem_supportedTensor (u : Fock μ) :
    B.split μ (MomentumSplit.split μ s hs) u ∈ supportedTensor μ s hs := by
  apply clm_mem_of_spanClosure (B.split μ (MomentumSplit.split μ s hs)).toContinuousLinearMap
    (supportedTensor μ s hs) (Submodule.isClosed_topologicalClosure _)
    (Set.range (creationWord μ)) _ u (B.words_total u)
  rintro _ ⟨w, rfl⟩
  have hsum : splitCreationTensor μ (MomentumSplit.split μ s hs) w ∈ supportedTensor μ s hs := by
    apply evaluated_list_mem
    intro p hp
    exact (Submodule.le_topologicalClosure _) (Submodule.subset_span
      ⟨p.1, p.2, (assignments_supported μ s hs w p hp).1,
        (assignments_supported μ s hs w p hp).2, rfl⟩)
  exact (B.split_word μ (MomentumSplit.split μ s hs) w).symm ▸ hsum

/-- Onto the genuine completed supported tensor space, proved from the word law. -/
theorem split_range :
    (B.split μ (MomentumSplit.split μ s hs)).toLinearMap.range =
      supportedTensor μ s hs := by
  apply le_antisymm
  · rintro _ ⟨u, rfl⟩
    exact split_mem_supportedTensor μ s hs B u
  · have hc : IsClosed ((B.split μ (MomentumSplit.split μ s hs)).toLinearMap.range :
        Set (TensorSpace (Fock μ) (Fock μ))) :=
      (B.split μ (MomentumSplit.split μ s hs)).isometry.isClosedEmbedding.isClosed_range
    apply closure_minimal _ hc
    apply Submodule.span_le.mpr
    rintro z ⟨u, v, hu, hv, rfl⟩
    refine ⟨creationWord μ (u ++ v), ?_⟩
    exact (B.split_word μ (MomentumSplit.split μ s hs) (u ++ v)).trans
      (splitCreationTensor_append_supported μ s hs u v hu hv)

/-- The completed tensor product of the two actual generated Fock subspaces. -/
abbrev SupportedFockTensor := TensorSpace
  (generatedSubspace μ (MomentumSplit.supported μ s hs))
  (generatedSubspace μ (MomentumSplit.supported μ sᶜ hs.compl))

def supportedTensorEmbedding : SupportedFockTensor μ s hs →ₗᵢ[ℂ]
    TensorSpace (Fock μ) (Fock μ) :=
  completedTensorMap
    (generatedSubspace μ (MomentumSplit.supported μ s hs)).subtypeₗᵢ
    (generatedSubspace μ (MomentumSplit.supported μ sᶜ hs.compl)).subtypeₗᵢ

theorem supportedTensorEmbedding_tensor
    (u : generatedSubspace μ (MomentumSplit.supported μ s hs))
    (v : generatedSubspace μ (MomentumSplit.supported μ sᶜ hs.compl)) :
    supportedTensorEmbedding μ s hs (tensor u v) = tensor u.val v.val :=
  completedTensorMap_tensor _ _ u v

private theorem tensor_generated_mem
    (u : generatedSubspace μ (MomentumSplit.supported μ s hs))
    (v : generatedSubspace μ (MomentumSplit.supported μ sᶜ hs.compl)) :
    tensor u.val v.val ∈ supportedTensor μ s hs := by
  apply tensor_spanClosure_mem (supportedTensor μ s hs)
    (Submodule.isClosed_topologicalClosure _)
    {z | ∃ w : List (Lp ℂ 2 μ), (∀ f ∈ w, f ∈ MomentumSplit.supported μ s hs) ∧
      z = creationWord μ w}
    {z | ∃ w : List (Lp ℂ 2 μ), (∀ f ∈ w, f ∈ MomentumSplit.supported μ sᶜ hs.compl) ∧
      z = creationWord μ w} _ u.val u.property v.val v.property
  rintro _ ⟨w, hw, rfl⟩ _ ⟨q, hq, rfl⟩
  exact (Submodule.le_topologicalClosure _) (Submodule.subset_span ⟨w, q, hw, hq, rfl⟩)

theorem supportedTensorEmbedding_range :
    (supportedTensorEmbedding μ s hs).toLinearMap.range = supportedTensor μ s hs := by
  apply le_antisymm
  · rintro _ ⟨z, rfl⟩
    apply tensor_clm_mem (supportedTensorEmbedding μ s hs).toContinuousLinearMap
      (supportedTensor μ s hs) (Submodule.isClosed_topologicalClosure _) _ z
    intro u v
    exact (supportedTensorEmbedding_tensor μ s hs u v).symm ▸ tensor_generated_mem μ s hs u v
  · have hc : IsClosed ((supportedTensorEmbedding μ s hs).toLinearMap.range :
        Set (TensorSpace (Fock μ) (Fock μ))) :=
      (supportedTensorEmbedding μ s hs).isometry.isClosedEmbedding.isClosed_range
    apply closure_minimal _ hc
    apply Submodule.span_le.mpr
    rintro _ ⟨u, v, hu, hv, rfl⟩
    refine ⟨tensor
      (⟨creationWord μ u, creationWord_mem_generated μ _ u hu⟩ :
        generatedSubspace μ (MomentumSplit.supported μ s hs))
      (⟨creationWord μ v, creationWord_mem_generated μ _ v hv⟩ :
        generatedSubspace μ (MomentumSplit.supported μ sᶜ hs.compl)), ?_⟩
    exact supportedTensorEmbedding_tensor μ s hs _ _

/-- The actual orthogonal Fock factorization is an onto Hilbert equivalence. -/
def supportedFockEquivalence : Fock μ ≃ₗᵢ[ℂ] SupportedFockTensor μ s hs :=
  equivalenceOfRange (B.split μ (MomentumSplit.split μ s hs)) (supportedTensorEmbedding μ s hs)
    ((split_range μ s hs B).trans (supportedTensorEmbedding_range μ s hs).symm)

theorem supportedFockEquivalence_embedding (u : Fock μ) :
    supportedTensorEmbedding μ s hs (supportedFockEquivalence μ s hs B u) =
      B.split μ (MomentumSplit.split μ s hs) u :=
  equivalenceOfRange_embedding _ _ _ u

end GptLean.PhysicalFock
