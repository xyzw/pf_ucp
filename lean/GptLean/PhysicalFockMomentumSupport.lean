import GptLean.PhysicalFockPositionSupport
import GptLean.PhysicalPhotonHardSoft

/-!
Momentum support of the completed Fock subspace generated by supported
one-photon kernels. The actual tensor insertion preserves product support,
and the actual symmetric projection preserves this closed invariant subspace.
Closure then gives the support statement for every generated Fock vector.
-/

noncomputable section

namespace GptLean.PhysicalFock.MomentumSupport

open MeasureTheory Filter Topology PhotonLocalization
open scoped ENNReal

set_option Elab.async false
set_option backward.isDefEq.respectTransparency.types false

def productRegion {Ω : Type*} (n : ℕ) (s : Set Ω) : Set (Fin n → Ω) :=
  {k | ∀ i, k i ∈ s}

variable {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) [SigmaFinite μ]

def fullSupport (n : ℕ) (s : Set Ω) : Submodule ℂ (FullSector μ n) :=
  spatialSupport (productRegion n s)

omit [SigmaFinite μ] in
theorem fullSupport_closed (n : ℕ) (s : Set Ω) :
    IsClosed (fullSupport μ n s : Set (FullSector μ n)) :=
  PhysicalLocalSupport.spatialSupport_closed (SectorMeasure μ n) _

theorem permutation_mem_fullSupport (n : ℕ) (s : Set Ω)
    (π : Equiv.Perm (Fin n)) (u : FullSector μ n) (hu : u ∈ fullSupport μ n s) :
    permutation μ n π u ∈ fullSupport μ n s := by
  have hp := measurePreserving_piCongrLeft (fun _ : Fin n => μ) π
  filter_upwards [permutation_ae μ n π u, hp.quasiMeasurePreserving.ae hu]
    with k hk hu
  intro hout
  apply hk.trans
  apply hu
  intro hin
  apply hout
  intro i
  have hi := hin (π i)
  change (MeasurableEquiv.piCongrLeft (fun _ : Fin n => Ω) π) k (π i) ∈ s at hi
  rwa [MeasurableEquiv.piCongrLeft_apply_apply] at hi

theorem symmetrizer_mem_fullSupport (n : ℕ) (s : Set Ω)
    (u : FullSector μ n) (hu : u ∈ fullSupport μ n s) :
    symmetrizer μ n u ∈ fullSupport μ n s :=
  PhysicalFockPositionSupport.symmetrizer_mem μ n (fullSupport μ n s)
    (fullSupport_closed μ n s) (permutation_mem_fullSupport μ n s) hu

omit [SigmaFinite μ] in
theorem vacuum_mem_fullSupport (s : Set Ω) (u : FullSector μ 0) :
    u ∈ fullSupport μ 0 s := by
  apply ae_of_all
  intro k hout
  exact False.elim (hout (fun i => Fin.elim0 i))

theorem tensorInsertion_mem_fullSupport (n : ℕ) (s : Set Ω)
    (f : Lp ℂ 2 μ) (hf : ∀ᵐ x ∂μ, x ∉ s → f x = 0)
    (u : FullSector μ n) (hu : u ∈ fullSupport μ n s) :
    tensorInsertion μ n f u ∈ fullSupport μ (n + 1) s := by
  have hp := measurePreserving_piFinSuccAbove (fun _ : Fin (n + 1) => μ) 0
  have hhead := hp.quasiMeasurePreserving.ae
    ((Measure.quasiMeasurePreserving_fst (ν := SectorMeasure μ n)).ae hf)
  have htail := hp.quasiMeasurePreserving.ae
    ((Measure.quasiMeasurePreserving_snd (μ := μ)).ae hu)
  filter_upwards [tensorInsertion_ae μ n f u, hhead, htail] with k hk hh ht
  intro hout
  change (k 0 ∉ s → f (k 0) = 0) at hh
  change ((fun i : Fin n => k i.succ) ∉ productRegion n s →
    u (fun i : Fin n => k i.succ) = 0) at ht
  by_cases hzero : k 0 ∈ s
  · have htailout : (fun i : Fin n => k i.succ) ∉ productRegion n s := by
      intro hin
      apply hout
      intro i
      exact Fin.cases hzero (fun j => hin j) i
    exact hk.trans (by rw [ht htailout, mul_zero])
  · exact hk.trans (by rw [hh hzero, zero_mul])

theorem creationSector_mem_fullSupport (n : ℕ) (s : Set Ω)
    (f : Lp ℂ 2 μ) (hf : ∀ᵐ x ∂μ, x ∉ s → f x = 0)
    (u : Sector μ n) (hu : u.val ∈ fullSupport μ n s) :
    (creationSector μ n f u).val ∈ fullSupport μ (n + 1) s := by
  change (Real.sqrt (n + 1 : ℝ) : ℂ) •
    symmetrizer μ (n + 1) (tensorInsertion μ n f u.val) ∈ _
  exact Submodule.smul_mem _ _ (symmetrizer_mem_fullSupport μ (n + 1) s _
    (tensorInsertion_mem_fullSupport μ n s f hf u.val hu))

theorem creationWordSector_mem_fullSupport (s : Set Ω)
    (w : List (Lp ℂ 2 μ)) (hw : ∀ f ∈ w, ∀ᵐ x ∂μ, x ∉ s → f x = 0) :
    (creationWordSector μ w).val ∈ fullSupport μ w.length s := by
  induction w with
  | nil => exact vacuum_mem_fullSupport μ s _
  | cons f w ih =>
    exact creationSector_mem_fullSupport μ w.length s f (hw f (List.mem_cons_self ..))
      (creationWordSector μ w) (ih (fun g hg => hw g (List.mem_cons_of_mem f hg)))

def sectorValue (n : ℕ) : Fock μ →L[ℂ] FullSector μ n :=
  (sectorInclusion μ n).toContinuousLinearMap.comp
    (lp.evalCLM ℂ (Sector μ) 2 n)

def fockSupport (s : Set Ω) : Submodule ℂ (Fock μ) :=
  ⨅ n : ℕ, (fullSupport μ n s).comap (sectorValue μ n).toLinearMap

theorem fockSupport_closed (s : Set Ω) : IsClosed (fockSupport μ s : Set (Fock μ)) := by
  rw [fockSupport, Submodule.coe_iInf]
  exact isClosed_iInter fun n =>
    (fullSupport_closed μ n s).preimage (sectorValue μ n).continuous

theorem creationWord_mem_fockSupport (s : Set Ω) (w : List (Lp ℂ 2 μ))
    (hw : ∀ f ∈ w, ∀ᵐ x ∂μ, x ∉ s → f x = 0) :
    creationWord μ w ∈ fockSupport μ s := by
  apply (Submodule.mem_iInf _).mpr
  intro n
  change sectorValue μ n (creationWord μ w) ∈ fullSupport μ n s
  by_cases hn : n = w.length
  · subst n
    change ((lp.single (E := Sector μ) 2 w.length (creationWordSector μ w)) w.length).val ∈ _
    rw [lp.single_apply_self]
    exact creationWordSector_mem_fullSupport μ s w hw
  · change ((lp.single (E := Sector μ) 2 w.length (creationWordSector μ w)) n).val ∈ _
    rw [lp.single_apply_ne _ _ _ hn]
    exact Submodule.zero_mem _

/-- Closure of the creation words retains actual product momentum support. -/
theorem generated_le_fockSupport (s : Set Ω) (hs : MeasurableSet s) :
    generatedSubspace μ (MomentumSplit.supported μ s hs) ≤ fockSupport μ s := by
  apply Submodule.topologicalClosure_minimal _ _ (fockSupport_closed μ s)
  apply Submodule.span_le.mpr
  rintro v ⟨w, hw, rfl⟩
  exact creationWord_mem_fockSupport μ s w (fun f hf =>
    (MomentumSplit.mem_supported_iff μ s hs f).mp (hw f hf))

end GptLean.PhysicalFock.MomentumSupport

namespace GptLean.PhysicalFock

open MeasureTheory
open scoped ENNReal

/-- Generated hard-photon support is the support predicate used by the
actual momentum radiation and number forms. -/
theorem hardSupported_of_mem_generated (κ : ℝ) (u : PhotonFock)
    (hu : u ∈ generatedFockSubspace (hardOnePhoton κ)) : HardSupported κ u := by
  have hsupport := MomentumSupport.generated_le_fockSupport photonMeasure
    (softMomentumSet κ)ᶜ (softMomentumSet_measurable κ).compl hu
  intro n
  have hn := (Submodule.mem_iInf _).mp hsupport n
  change ∀ᵐ k ∂SectorMeasure photonMeasure n,
    k ∉ MomentumSupport.productRegion n (softMomentumSet κ)ᶜ → (u n).val k = 0 at hn
  filter_upwards [hn] with k hk
  intro hne i
  by_contra hbound
  apply hne
  apply hk
  intro hall
  apply hall i
  exact not_le.mp hbound

end GptLean.PhysicalFock
