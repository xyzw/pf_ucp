import GptLean.PhysicalFockMomentumSupport
import GptLean.PhysicalFockHardField
import GptLean.PhysicalFockRadiationCore

/-!
The actual product-momentum restriction on the symmetric Fock model.
Its action on creation words identifies product support with the closed
Fock subspace generated by supported one-photon kernels. This also proves
that the actual radiation square root preserves the hard Fock subspace.
-/

noncomputable section

namespace GptLean.PhysicalFock.MomentumSupport

open MeasureTheory Filter Topology PhotonLocalization
open scoped ENNReal InnerProductSpace

set_option Elab.async false
set_option backward.isDefEq.respectTransparency.types false

variable {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) [SigmaFinite μ]
  (s : Set Ω) (hs : MeasurableSet s)

include hs in
theorem productRegion_measurable (n : ℕ) : MeasurableSet (productRegion n s) :=
  by
    simp only [productRegion, Set.ofPred_forall]
    exact MeasurableSet.iInter fun i => hs.preimage (measurable_pi_apply i)

private theorem productRegion_permutation (n : ℕ) (π : Equiv.Perm (Fin n))
    (k : Fin n → Ω) :
    MeasurableEquiv.piCongrLeft (fun _ : Fin n => Ω) π k ∈ productRegion n s ↔
      k ∈ productRegion n s := by
  constructor
  · intro h i
    have hi := h (π i)
    change (MeasurableEquiv.piCongrLeft (fun _ : Fin n => Ω) π) k (π i) ∈ s at hi
    rwa [MeasurableEquiv.piCongrLeft_apply_apply] at hi
  · intro h i
    rw [← π.apply_symm_apply i, MeasurableEquiv.piCongrLeft_apply_apply]
    exact h _

def fullProjection (n : ℕ) : FullSector μ n →L[ℂ] FullSector μ n :=
  MomentumSplit.projection (SectorMeasure μ n) (productRegion n s)
    (productRegion_measurable s hs n)

omit [SigmaFinite μ] in
theorem fullProjection_ae (n : ℕ) (u : FullSector μ n) :
    fullProjection μ s hs n u =ᵐ[SectorMeasure μ n] (productRegion n s).indicator u :=
  MomentumSplit.projection_ae _ _ _ u

theorem fullProjection_symmetric (n : ℕ) (u : Sector μ n) :
    fullProjection μ s hs n u.val ∈ symmetricSubspace μ n := by
  intro π
  apply Lp.ext
  have hp := measurePreserving_piCongrLeft (fun _ : Fin n => μ) π
  filter_upwards [permutation_ae μ n π (fullProjection μ s hs n u.val),
    fullProjection_ae μ s hs n u.val,
    hp.quasiMeasurePreserving.ae (fullProjection_ae μ s hs n u.val),
    symmetric_ae μ n u π] with k hperm hv hvp hu
  change (permutation μ n π (fullProjection μ s hs n u.val)) k = _
  rw [hperm, hv]
  change (fullProjection μ s hs n u.val)
    (MeasurableEquiv.piCongrLeft (fun _ : Fin n => Ω) π k) = _
  rw [hvp]
  classical
  by_cases hk : k ∈ productRegion n s
  · simp only [Set.indicator_of_mem hk,
      Set.indicator_of_mem ((productRegion_permutation s n π k).mpr hk)]
    exact hu.symm
  · simp only [Set.indicator_of_notMem hk,
      Set.indicator_of_notMem (mt (productRegion_permutation s n π k).mp hk)]

theorem fullProjection_symmetrizer (n : ℕ) (u : FullSector μ n) :
    fullProjection μ s hs n (symmetrizer μ n u) =
      symmetrizer μ n (fullProjection μ s hs n u) := by
  symm
  exact PhysicalInvariantProjection.symmetric_projection (symmetricSubspace μ n)
    (fullProjection μ s hs n)
    (ContinuousLinearMap.isSelfAdjoint_iff_isSymmetric.mp
      (MomentumSplit.projection_selfadjoint _ _ _))
    (fun v hv => fullProjection_symmetric μ s hs n ⟨v, hv⟩) u

theorem fullProjection_tensorInsertion (n : ℕ) (f : Lp ℂ 2 μ)
    (u : FullSector μ n) :
    fullProjection μ s hs (n + 1) (tensorInsertion μ n f u) =
      tensorInsertion μ n (MomentumSplit.projection μ s hs f)
        (fullProjection μ s hs n u) := by
  apply Lp.ext
  have hp := measurePreserving_piFinSuccAbove (fun _ : Fin (n + 1) => μ) 0
  have hh := hp.quasiMeasurePreserving.ae
    ((Measure.quasiMeasurePreserving_fst (ν := SectorMeasure μ n)).ae
      (MomentumSplit.projection_ae μ s hs f))
  have ht := hp.quasiMeasurePreserving.ae
    ((Measure.quasiMeasurePreserving_snd (μ := μ)).ae (fullProjection_ae μ s hs n u))
  filter_upwards [fullProjection_ae μ s hs (n + 1) (tensorInsertion μ n f u),
    tensorInsertion_ae μ n f u,
    tensorInsertion_ae μ n (MomentumSplit.projection μ s hs f)
      (fullProjection μ s hs n u), hh, ht] with k hP hT hPT hh ht
  change (MomentumSplit.projection μ s hs f) (k 0) = s.indicator f (k 0) at hh
  change fullProjection μ s hs n u (fun i : Fin n => k i.succ) =
    (productRegion n s).indicator u (fun i : Fin n => k i.succ) at ht
  rw [hP, hPT, hh, ht]
  classical
  have hsplit : k ∈ productRegion (n + 1) s ↔
      k 0 ∈ s ∧ (fun i : Fin n => k i.succ) ∈ productRegion n s :=
    ⟨fun h => ⟨h 0, fun i => h i.succ⟩,
      fun h i => Fin.cases h.1 (fun j => h.2 j) i⟩
  by_cases hh' : k 0 ∈ s <;>
    by_cases ht' : (fun i : Fin n => k i.succ) ∈ productRegion n s <;>
    simp [hsplit, hh', ht', hT]

def sectorProjection (n : ℕ) : Sector μ n →L[ℂ] Sector μ n :=
  ((fullProjection μ s hs n).comp (sectorInclusion μ n).toContinuousLinearMap).codRestrict
    (symmetricSubspace μ n) (fullProjection_symmetric μ s hs n)

theorem sectorProjection_norm_le (n : ℕ) : ‖sectorProjection μ s hs n‖ ≤ 1 := by
  apply ContinuousLinearMap.opNorm_le_bound _ zero_le_one
  intro u
  exact PhotonLocalization.realL2Multiplier_norm_le
    (MomentumSplit.weight (productRegion n s))
    (MomentumSplit.weight_measurable (productRegion n s)
      (productRegion_measurable s hs n)).aestronglyMeasurable
    1 (ae_of_all _ (MomentumSplit.weight_bound (productRegion n s))) u.val

theorem sectorProjection_creation (n : ℕ) (f : Lp ℂ 2 μ) (u : Sector μ n) :
    sectorProjection μ s hs (n + 1) (creationSector μ n f u) =
      creationSector μ n (MomentumSplit.projection μ s hs f) (sectorProjection μ s hs n u) := by
  apply Subtype.ext
  change fullProjection μ s hs (n + 1)
      ((Real.sqrt (n + 1 : ℝ) : ℂ) • symmetrizer μ (n + 1) (tensorInsertion μ n f u.val)) = _
  rw [map_smul, fullProjection_symmetrizer, fullProjection_tensorInsertion]
  rfl

def fockProjection : Fock μ →L[ℂ] Fock μ :=
  lp.mapCLM 2 (sectorProjection μ s hs) zero_le_one (sectorProjection_norm_le μ s hs)

@[simp] theorem fockProjection_apply (u : Fock μ) (n : ℕ) :
    fockProjection μ s hs u n = sectorProjection μ s hs n (u n) := rfl

theorem fockProjection_single (n : ℕ) (u : Sector μ n) :
    fockProjection μ s hs (lp.single 2 n u) =
      lp.single 2 n (sectorProjection μ s hs n u) := by
  apply lp.ext
  funext m
  by_cases hm : m = n
  · subst m
    simp only [fockProjection_apply, lp.single_apply_self]
  · simp only [fockProjection_apply, lp.single_apply_ne _ _ _ hm, map_zero]

theorem fockProjection_creationBlock (n : ℕ) (f : Lp ℂ 2 μ) (u : Fock μ) :
    fockProjection μ s hs (creationBlock μ n f u) =
      creationBlock μ n (MomentumSplit.projection μ s hs f) (fockProjection μ s hs u) := by
  change fockProjection μ s hs (lp.single 2 (n + 1) (creationSector μ n f (u n))) = _
  rw [fockProjection_single, sectorProjection_creation]
  rfl

theorem fockProjection_fixed (u : Fock μ) (hu : u ∈ fockSupport μ s) :
    fockProjection μ s hs u = u := by
  apply lp.ext
  funext n
  apply Subtype.ext
  have hn := (Submodule.mem_iInf _).mp hu n
  change ∀ᵐ k ∂SectorMeasure μ n, k ∉ productRegion n s → (u n).val k = 0 at hn
  have hn' : (u n).val ∈ MomentumSplit.supported (SectorMeasure μ n)
      (productRegion n s) (productRegion_measurable s hs n) :=
    (MomentumSplit.mem_supported_iff _ _ _ _).mpr hn
  exact MomentumSplit.projection_of_supported _ _ _ ⟨(u n).val, hn'⟩

theorem fockProjection_word_mem_generated (w : List (Lp ℂ 2 μ)) :
    fockProjection μ s hs (creationWord μ w) ∈
      generatedSubspace μ (MomentumSplit.supported μ s hs) := by
  induction w with
  | nil =>
    rw [fockProjection_fixed μ s hs _
      (creationWord_mem_fockSupport μ s [] (by simp))]
    exact creationWord_mem_generated μ _ [] (by simp)
  | cons f w ih =>
    have hc : creationBlock μ w.length f (creationWord μ w) = creationWord μ (f :: w) :=
      creationBlock_single μ w.length f (creationWordSector μ w)
    rw [← hc, fockProjection_creationBlock]
    exact creationBlock_mem_generated μ _ w.length _
      (MomentumSplit.projection_mem_supported μ s hs f) _ ih

/-- Product momentum support gives membership in the generated subspace.
Only the already fixed universal density of creation words is used. -/
theorem fockSupport_le_generated (B : ConcreteExponentialLaw μ) :
    fockSupport μ s ≤ generatedSubspace μ (MomentumSplit.supported μ s hs) := by
  let M := (generatedSubspace μ (MomentumSplit.supported μ s hs)).comap
    (fockProjection μ s hs).toLinearMap
  have hspan : Submodule.span ℂ (Set.range (creationWord μ)) ≤ M := by
    apply Submodule.span_le.mpr
    rintro u ⟨w, rfl⟩
    exact fockProjection_word_mem_generated μ s hs w
  have hclosed : IsClosed (M : Set (Fock μ)) :=
    (Submodule.isClosed_topologicalClosure _).preimage (fockProjection μ s hs).continuous
  intro u hu
  have himage := (closure_minimal hspan hclosed) (B.words_total u)
  change fockProjection μ s hs u ∈ generatedSubspace μ (MomentumSplit.supported μ s hs)
    at himage
  rwa [fockProjection_fixed μ s hs u hu] at himage

theorem generated_eq_fockSupport (B : ConcreteExponentialLaw μ) :
    generatedSubspace μ (MomentumSplit.supported μ s hs) = fockSupport μ s :=
  le_antisymm (generated_le_fockSupport μ s hs) (fockSupport_le_generated μ s hs B)

end GptLean.PhysicalFock.MomentumSupport

namespace GptLean.PhysicalFock

open MeasureTheory
open scoped ENNReal

/-- The support condition of the actual radiation form is exactly the
hard generated Fock subspace. -/
theorem mem_generated_of_hardSupported (BF : StandardSymmetricFockExponential)
    (κ : ℝ) (u : PhotonFock) (hu : HardSupported κ u) :
    u ∈ generatedFockSubspace (hardOnePhoton κ) := by
  apply MomentumSupport.fockSupport_le_generated photonMeasure (softMomentumSet κ)ᶜ
    (softMomentumSet_measurable κ).compl (photonExponential BF)
  apply (Submodule.mem_iInf _).mpr
  intro n
  change ∀ᵐ k ∂SectorMeasure photonMeasure n,
    k ∉ MomentumSupport.productRegion n (softMomentumSet κ)ᶜ → (u n).val k = 0
  filter_upwards [hu n] with k hk
  intro hout
  by_contra hz
  apply hout
  intro i
  exact not_lt.mpr (hk hz i)

theorem mem_generated_iff_hardSupported (BF : StandardSymmetricFockExponential)
    (κ : ℝ) (u : PhotonFock) :
    u ∈ generatedFockSubspace (hardOnePhoton κ) ↔ HardSupported κ u :=
  ⟨hardSupported_of_mem_generated κ u, mem_generated_of_hardSupported BF κ u⟩

/-- Multiplication by the actual square-root dispersion preserves hard support. -/
theorem radiationGraphDerivative_hardSupported (κ : ℝ) (q : RadiationGraphSpace)
    (hq : HardSupported κ (radiationGraphInclusion q)) :
    HardSupported κ (radiationGraphDerivative q) := by
  intro n
  filter_upwards [hq n, (radiationRoot_graph_iff (radiationGraphInclusion q)
    (radiationGraphDerivative q)).mp (radiationGraph_pair q) n] with k hk hr
  intro hz
  apply hk
  intro hzero
  have hr' : (radiationGraphDerivative q n).val k =
      (Real.sqrt (sectorDispersion n k) : ℂ) * (radiationGraphInclusion q n).val k := hr
  exact hz (hr'.trans ((congrArg
    (fun z : ℂ => (Real.sqrt (sectorDispersion n k) : ℂ) * z) hzero).trans (mul_zero _)))

/-- The hard Fock subspace reduces the actual radiation square-root graph. -/
theorem radiationGraphDerivative_mem_hardGenerated
    (BF : StandardSymmetricFockExponential) (κ : ℝ) (q : RadiationGraphSpace)
    (hq : radiationGraphInclusion q ∈ generatedFockSubspace (hardOnePhoton κ)) :
    radiationGraphDerivative q ∈ generatedFockSubspace (hardOnePhoton κ) :=
  mem_generated_of_hardSupported BF κ _
    (radiationGraphDerivative_hardSupported κ q
      (hardSupported_of_mem_generated κ _ hq))

end GptLean.PhysicalFock
