  let allowed : List Name := [``propext, ``Classical.choice, ``Quot.sound]
  let mut moduleCount : Nat := 0
  let mut declarationCount : Nat := 0
  let mut theoremCount : Nat := 0
  let mut definitionCount : Nat := 0
  let mut failures : Array (Name × Array Name) := #[]
  for i in [:env.header.moduleNames.size] do
    if modules.contains env.header.moduleNames[i]! then
      moduleCount := moduleCount + 1
      for name in env.header.moduleData[i]!.constNames do
        declarationCount := declarationCount + 1
        match env.find? name with
        | some (.thmInfo _) => theoremCount := theoremCount + 1
        | some (.defnInfo _) => definitionCount := definitionCount + 1
        | _ => pure ()
        let axioms ← liftCoreM (Lean.collectAxioms name)
        let unexpected := axioms.filter fun ax => !allowed.contains ax
        if !unexpected.isEmpty then
          failures := failures.push (name, unexpected)
  if moduleCount != modules.length then
    logError m!"Expected {modules.length} modules, found {moduleCount}"
  else if theoremCount == 0 then
    logError "No theorems were imported"
  else if failures.isEmpty then
    logInfo m!"Checked {declarationCount} declarations in {moduleCount} modules"
    logInfo m!"Found {theoremCount} theorems and {definitionCount} definitions"
    logInfo "No sorryAx or axioms beyond propext, Classical.choice and Quot.sound"
  else
    for (name, axioms) in failures do
      logError m!"Unexpected axioms in {name} = {axioms}"
